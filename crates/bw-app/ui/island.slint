// L'île : une pilule en haut-centre de l'écran, dans une fenêtre transparente
// fixe dimensionnée pour l'état ouvert. Toute la logique (quand ouvrir, quoi
// afficher) vit côté Rust ; ce fichier ne fait que dessiner l'état reçu.
//
// Seules les transitions déclenchent un rendu : aucune animation en boucle,
// pour rester à ~0 % CPU au repos.

export struct ClaudeRow {
    id: string,
    project: string,
    status: string,
    urgent: bool,
    active: bool,
}

export struct ClaudePrompt {
    id: string,
    project: string,
    tool: string,
    detail: string,
}

export struct AgendaRow {
    title: string,
    time: string,
    location: string,
    relative: string,
    join-url: string,
    has-join: bool,
    soon: bool,
}

export struct RecentRow {
    id: string,
    title: string,
    meta: string,
}

export struct PluginRow {
    name: string,
    text: string,
    attention: int,
}

export struct ShelfRow {
    name: string,
    path: string,
}

export struct TimerInfo {
    /// 0 prêt, 1 en cours, 2 en pause, 3 terminé.
    phase: int,
    time: string,
    progress: float,
    presets: [string],
}

export struct MediaInfo {
    title: string,
    artist: string,
    source: string,
    playing: bool,
    can-previous: bool,
    can-next: bool,
    can-toggle: bool,
    can-seek: bool,
    has-art: bool,
    art: image,
    has-timeline: bool,
    position: string,
    duration: string,
    progress: float,
    multi-source: bool,
}

export struct NotifInfo {
    id: int,
    app: string,
    title: string,
    body: string,
    tint: color,
    initial: string,
    has-icon: bool,
    icon: image,
    ago: string,
}

export struct GaugeInfo {
    /// bolt | battery | headphones | bluetooth
    icon: string,
    /// Niveau en %, -1 s'il est inconnu.
    level: int,
    charging: bool,
    low: bool,
}

export struct WeatherInfo {
    /// sun | moon | cloud-sun | cloud-moon | cloud | fog | drizzle | rain | snow | storm
    icon: string,
    temperature: string,
    detail: string,
}

// Processeur et mémoire dans l'en-tête ; au survol, le détail remplace la date.
export struct SystemInfo {
    cpu: string,
    ram: string,
    detail: string,
    // Au-dessus de 90 % : en couleur d'alerte.
    cpu-hot: bool,
    ram-hot: bool,
}

// Pictogrammes au trait, viewbox 24x24 (tracés d'après Lucide, licence ISC).
component Glyph inherits Path {
    in property <string> name;
    in property <color> ink;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.name == "bolt" ? root.ink : transparent;
    stroke: root.name == "bolt" ? transparent : root.ink;
    stroke-width: 2px;
    commands: root.name == "sun" ? "M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M6.34 17.66l-1.41 1.41 M19.07 4.93l-1.41 1.41 M16 12a4 4 0 1 1-8 0a4 4 0 1 1 8 0"
        : root.name == "moon" ? "M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"
        : root.name == "cloud-sun" ? "M12 2v2 M4.93 4.93l1.41 1.41 M20 12h2 M19.07 4.93l-1.41 1.41 M15.947 12.65a4 4 0 0 0-5.925-4.128 M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"
        : root.name == "cloud-moon" ? "M13 16a3 3 0 1 1 0 6H7a5 5 0 1 1 4.9-6Z M10.1 9A6 6 0 0 1 16 4a4 4 0 0 0 6 6 6 6 0 0 1-3 5.197"
        : root.name == "fog" ? "M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M16 17H7 M17 21H9"
        : root.name == "drizzle" ? "M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M8 19v1 M8 14v1 M16 19v1 M16 14v1 M12 21v1 M12 16v1"
        : root.name == "rain" ? "M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M16 14v6 M8 14v6 M12 16v6"
        : root.name == "snow" ? "M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242 M8 15v1 M8 19v1 M12 17v1 M12 21v1 M16 15v1 M16 19v1"
        : root.name == "storm" ? "M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.973 M13 12l-3 5h4l-3 5"
        : root.name == "headphones" ? "M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"
        : root.name == "bluetooth" ? "M7 7l10 10-5 5V2l5 5L7 17"
        : root.name == "bolt" ? "M13 2L4.5 13.5H11L10 22l8.5-11.5H12Z"
        : root.name == "cpu" ? "M12 20v2 M12 2v2 M17 20v2 M17 2v2 M2 12h2 M2 17h2 M2 7h2 M20 12h2 M20 17h2 M20 7h2 M7 20v2 M7 2v2 M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M9 8h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"
        : root.name == "memory" ? "M6 19v-3 M10 19v-3 M14 19v-3 M18 19v-3 M8 11V9 M16 11V9 M12 11V9 M2 15h20 M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1.1a2 2 0 0 0 0 3.837V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.1a2 2 0 0 0 0-3.837Z"
        : root.name == "battery" ? "M16 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z M22 11v2"
        : "M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z";
}

// Batterie dessinée : contour, téton et remplissage au niveau.
component BatteryGauge inherits Rectangle {
    in property <float> level;
    in property <color> ink;
    in property <color> fill;
    width: 25px;
    height: 12px;

    Rectangle {
        x: 0;
        width: parent.width - 3px;
        border-radius: 3.5px;
        border-width: 1px;
        border-color: root.ink.with-alpha(0.45);

        Rectangle {
            x: 2px;
            y: 2px;
            height: parent.height - 4px;
            width: (parent.width - 4px) * clamp(root.level, 0, 1);
            border-radius: 1.5px;
            background: root.fill;
            animate width { duration: 400ms; easing: ease-out-quint; }
        }
    }

    Rectangle {
        x: parent.width - 2px;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: 4px;
        border-radius: 1px;
        background: root.ink.with-alpha(0.45);
    }
}

// Œil de la mascotte, selon l'humeur.
component MascotEye inherits Rectangle {
    // open | closed | happy | half | big
    in property <string> kind;
    in property <color> ink;
    width: 4px;
    height: 5px;

    if root.kind == "happy": Path {
        width: 3.6px;
        height: 2.6px;
        y: 1.5px;
        viewbox-width: 4;
        viewbox-height: 3;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.3px;
        commands: "M0 3 L2 0.6 L4 3";
    }

    if root.kind != "happy": Rectangle {
        property <length> h: root.kind == "closed" ? 1.3px : root.kind == "half" ? 2px
            : root.kind == "big" ? 4.6px : 3.6px;
        width: root.kind == "big" ? 3.4px : 2.8px;
        height: self.h;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.h - (root.kind == "closed" ? 1px : 0px);
        border-radius: Math.min(self.width, self.h) / 2;
        background: root.ink;
    }
}

// La mascotte : un petit blob à yeux. Elle ne s'anime que si `animated`
// (le minuteur interne ne tourne pas sinon : rien n'est redessiné au repos).
component Mascot inherits Rectangle {
    // idle | morning | evening | sleep | work | wait | happy | music
    in property <string> mood: "idle";
    // "" | halloween | christmas | newyear
    in property <string> season;
    in property <bool> animated;
    // Basses de la musique (0 à 1).
    in property <float> level;
    in property <color> body-color: white;
    in property <color> eye-color: black;
    in property <color> accent: #ff8a3d;
    width: 26px;
    height: 24px;

    // Temps écoulé (s), avancé seulement pendant l'animation.
    property <float> t;
    Timer {
        interval: 40ms;
        running: root.animated;
        triggered => { root.t += 0.04; }
    }

    property <bool> calm: root.mood == "idle" || root.mood == "morning" || root.mood == "evening";
    property <bool> blink: root.animated && root.calm && Math.mod(root.t, 3.7) < 0.14;
    property <length> hop: !root.animated ? 0px
        : root.mood == "wait" ? -Math.abs(Math.sin(root.t * 2 * 360deg)) * 3px
        : root.mood == "happy" ? -Math.abs(Math.sin(root.t * 1.2 * 360deg)) * 2.5px
        : root.mood == "work" ? Math.sin(root.t * 1.6 * 360deg) * 1px
        : root.mood == "music" ? -root.level * 4px
        : 0px;
    // Respiration lente.
    property <length> breath: root.animated && root.calm ? Math.sin(root.t * 0.25 * 360deg) * 0.7px : 0px;
    property <length> look: root.animated && root.mood == "work" ? Math.sin(root.t * 0.8 * 360deg) * 1.3px : 0px;
    property <string> eyes: root.blink || root.mood == "sleep" ? "closed"
        : root.mood == "happy" || root.mood == "music" || root.mood == "morning" ? "happy"
        : root.mood == "evening" ? "half"
        : root.mood == "wait" ? "big" : "open";

    body := Rectangle {
        x: 4px;
        y: 9px + root.hop - root.breath;
        width: 18px;
        height: 14px + root.breath;
        border-radius: 7px;
        background: root.mood == "wait" ? root.accent : root.body-color;
        animate background { duration: 200ms; }

        // Reflet.
        Rectangle {
            x: 4px;
            y: 2.5px;
            width: 4px;
            height: 2px;
            border-radius: 1px;
            background: white.with-alpha(0.35);
        }

        MascotEye {
            x: 3.5px + root.look;
            y: 3px;
            kind: root.eyes;
            ink: root.eye-color;
        }

        MascotEye {
            x: 10.5px + root.look;
            y: 3px;
            kind: root.eyes;
            ink: root.eye-color;
        }

        // Sourire quand Claude a fini ou que la musique joue.
        if root.mood == "happy" || root.mood == "music": Path {
            x: 7px;
            y: 9.5px;
            width: 4px;
            height: 2px;
            viewbox-width: 4;
            viewbox-height: 2;
            fill: transparent;
            stroke: root.eye-color;
            stroke-width: 1.1px;
            commands: "M0 0 Q2 2.4 4 0";
        }
    }

    // Chapeaux de saison.
    if root.season == "halloween": Rectangle {
        x: body.x + 2px;
        y: body.y - 8px;
        width: 14px;
        height: 9px;

        Path {
            width: 9px;
            height: 8px;
            x: 2.5px;
            viewbox-width: 9;
            viewbox-height: 8;
            fill: #4B2470;
            commands: "M0 8 L9 8 L5.5 0 Z";
        }

        Rectangle {
            x: 3.5px;
            y: 6px;
            width: 7px;
            height: 1.2px;
            background: #FF8C1A;
        }

        Rectangle {
            y: 7.5px;
            height: 1.5px;
            border-radius: 0.75px;
            background: #2E1446;
        }
    }

    if root.season == "christmas": Rectangle {
        x: body.x + 3px;
        y: body.y - 7px;
        width: 14px;
        height: 8px;

        Path {
            width: 11px;
            height: 7px;
            viewbox-width: 11;
            viewbox-height: 7;
            fill: #E53935;
            commands: "M0 7 L10 7 L9 0 Z";
        }

        Rectangle {
            x: 7.5px;
            y: -1.5px;
            width: 3.4px;
            height: 3.4px;
            border-radius: 1.7px;
            background: white;
        }

        Rectangle {
            x: -0.5px;
            y: 5.6px;
            width: 12px;
            height: 2px;
            border-radius: 1px;
            background: white;
        }
    }

    if root.season == "newyear": Rectangle {
        x: body.x + 5px;
        y: body.y - 8px;
        width: 8px;
        height: 9px;

        Path {
            width: 8px;
            height: 8px;
            y: 1px;
            viewbox-width: 8;
            viewbox-height: 8;
            fill: #FFD60A;
            commands: "M0 8 L8 8 L4 0 Z";
        }

        Rectangle {
            x: 2.5px;
            y: 0px;
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: #FF375F;
        }
    }

    // Sommeil : un petit « z ».
    if root.mood == "sleep": Text {
        x: body.x + body.width - 2px;
        y: body.y - 9px;
        text: "z";
        color: root.body-color.with-alpha(0.7);
        font-size: 8px;
        font-weight: 700;
    }

    // Claude t'attend : un « ! ».
    if root.mood == "wait": Text {
        x: body.x + body.width + 1px;
        y: body.y - 6px + root.hop / 2;
        text: "!";
        color: root.accent;
        font-size: 11px;
        font-weight: 900;
    }
}

// Petite citrouille (Halloween).
component Pumpkin inherits Rectangle {
    in property <length> size: 12px;
    width: root.size;
    height: root.size;

    Rectangle {
        y: root.size * 0.22;
        height: root.size * 0.78;
        border-radius: self.height / 2;
        background: #FF8C1A;
    }

    // Côtes.
    Rectangle {
        x: root.size * 0.3;
        y: root.size * 0.22;
        width: root.size * 0.4;
        height: root.size * 0.78;
        border-radius: self.width / 2;
        background: #E86F00;
    }

    Rectangle {
        x: root.size * 0.42;
        y: 0;
        width: root.size * 0.16;
        height: root.size * 0.3;
        border-radius: root.size * 0.05;
        background: #3C8D2F;
    }
}

// Décorations de saison de l'île ouverte : citrouilles, neige, confettis.
// Statiques : rien ne tourne au repos.
component SeasonDecor inherits Rectangle {
    in property <string> season;

    if root.season == "halloween": Rectangle {
        Pumpkin {
            x: parent.width - 34px;
            y: parent.height - 18px;
            size: 13px;
        }

        Pumpkin {
            x: parent.width - 20px;
            y: parent.height - 14px;
            size: 9px;
        }
    }

    if root.season == "christmas": Rectangle {
        for flake in [
            { x: 0.06, y: 0.82, s: 3px },
            { x: 0.14, y: 0.9, s: 2px },
            { x: 0.83, y: 0.86, s: 3px },
            { x: 0.9, y: 0.78, s: 2px },
            { x: 0.95, y: 0.9, s: 2.5px },
            { x: 0.03, y: 0.68, s: 2px },
        ]: Rectangle {
            x: parent.width * flake.x;
            y: parent.height * flake.y;
            width: flake.s;
            height: flake.s;
            border-radius: flake.s / 2;
            background: white.with-alpha(0.75);
        }
    }

    if root.season == "newyear": Rectangle {
        for bit[i] in [
            { x: 0.88, y: 0.75, c: #FFD60A },
            { x: 0.92, y: 0.86, c: #FF375F },
            { x: 0.95, y: 0.7, c: #64D2FF },
            { x: 0.85, y: 0.9, c: #30D158 },
            { x: 0.05, y: 0.85, c: #BF5AF2 },
        ]: Rectangle {
            x: parent.width * bit.x;
            y: parent.height * bit.y;
            width: 3px;
            height: 1.6px;
            border-radius: 0.8px;
            background: bit.c;
        }
    }
}

// Icônes dessinées (pas de police d'icônes à embarquer), viewbox 24x24.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <bool> enabled: true;
    in property <length> size: 30px;
    // Bouton plein (lecture/pause) : disque de la couleur de l'encre, icône
    // de la couleur `hole`.
    in property <bool> filled;
    in property <color> hole: black;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.filled ? (ta.pressed ? root.ink.darker(0.15) : root.ink)
        : ta.has-hover && root.enabled ? root.ink.with-alpha(0.12) : transparent;
    opacity: root.enabled ? 1 : 0.3;
    animate background { duration: 120ms; }

    Path {
        width: root.size * (root.filled ? 0.46 : 0.6);
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.filled ? root.hole : root.ink;
        commands: root.icon == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon == "pause" ? "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"
            : root.icon == "next" ? "M 4 5 L 14 12 L 4 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : root.icon == "moon" ? "M 20.5 14.5 A 9 9 0 1 1 9.5 3.5 A 7 7 0 0 0 20.5 14.5 Z"
            : "M 20 5 L 10 12 L 20 19 Z M 6 5 L 9 5 L 9 19 L 6 19 Z";
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Dot inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <color> fill;
    in property <color> ink;
    in property <color> line: transparent;
    // Faux : le bouton garde sa taille au lieu de remplir la ligne.
    in property <bool> grow: true;
    callback clicked;

    height: 28px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: root.grow ? 1 : 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.line;
    background: ta.pressed ? root.fill.darker(0.2) : ta.has-hover ? root.fill.brighter(0.15) : root.fill;
    animate background { duration: 120ms; }

    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pastille ronde de l'application : son icône sur un fond de sa couleur, ou
// à défaut son initiale.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <bool> has-icon;
    in property <image> icon;
    in property <length> size: 36px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.has-icon ? root.tint.with-alpha(0.22)
        : @radial-gradient(circle, root.tint.brighter(0.35) 0%, root.tint 100%);

    if root.has-icon: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size * 0.68;
        height: root.size * 0.68;
        source: root.icon;
        image-fit: contain;
    }

    if !root.has-icon: Text {
        text: root.initial;
        color: white;
        font-size: root.size * 0.46;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TabChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <int> badge;
    in property <color> ink;
    in property <color> accent;
    callback clicked;

    // Largeur fixe : l'indicateur du contrôle segmenté glisse d'un cran à l'autre.
    width: 62px;
    height: 22px;

    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: root.text;
            color: root.active ? root.ink : ta.has-hover ? root.ink.with-alpha(0.85) : root.ink.with-alpha(0.55);
            font-size: 12px;
            font-weight: root.active ? 650 : 500;
            vertical-alignment: center;
            animate color { duration: 150ms; }
        }

        if root.badge > 0: Rectangle {
            width: max(14px, count.preferred-width + 8px);
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: root.accent;

            count := Text {
                text: root.badge > 9 ? "9+" : "\{root.badge}";
                color: white;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Island inherits Window {
    title: "BoringWindows";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // --- Thème (depuis config.toml) ---
    in property <length> compact-width: 190px;
    in property <length> compact-height: 32px;
    in property <length> attention-width: 300px;
    in property <length> attention-height: 36px;
    in property <length> expanded-width: 520px;
    in property <length> expanded-height: 170px;
    // Pilule qui annonce une notification (calculée côté Rust).
    in property <length> notif-width: 380px;
    in property <length> notif-height: 58px;
    in property <length> corner-radius: 22px;
    in property <length> top-offset: 0px;
    in property <duration> anim: 240ms;
    in property <color> bg: black;
    in property <color> fg: white;
    in property <color> accent: #ff8a3d;
    in property <color> border: transparent;
    // Police ; vide : celle du système.
    in property <string> font;
    default-font-family: root.font;

    // --- État ---
    in property <bool> expanded;
    in property <bool> has-attention;
    in property <bool> urgent;
    in property <string> attention-label;
    in property <string> time-text: "--:--";
    in property <string> date-text;
    in property <[ClaudeRow]> claude-rows;
    in property <bool> has-prompt;
    in property <ClaudePrompt> prompt;
    in property <bool> has-media;
    in property <MediaInfo> media;
    in property <[AgendaRow]> agenda-rows;
    // Onglet Claude : consommation estimée et conversations récentes.
    in property <bool> has-claude-tab;
    in-out property <int> tab;
    in property <[RecentRow]> recent-rows;
    in property <string> usage-text;
    in property <float> usage-ratio;
    in property <bool> usage-has-limit;
    callback recent-open(string /* id de session */);
    changed expanded => {
        if !self.expanded {
            self.tab = 0;
        }
    }
    in property <[float]> viz-bars;
    in property <[PluginRow]> plugin-rows;
    in property <[ShelfRow]> shelf-rows;
    in property <string> shelf-more;
    callback shelf-open(int);
    callback shelf-remove(int);
    in property <bool> custom-view;
    in property <component-factory> custom-view-factory;
    in property <bool> has-timer;
    in property <TimerInfo> timer;
    callback timer-action(string /* start:<min> | pause | resume | reset */);
    in property <bool> compact-art-visible;
    in property <image> compact-art;
    // Batterie ou appareil Bluetooth en tête de pilule : icône et jauge.
    in property <bool> compact-gauge-visible;
    in property <GaugeInfo> compact-gauge;
    // Météo à côté de la date ; au survol, le détail remplace la date.
    in property <bool> has-weather;
    in property <WeatherInfo> weather;
    // Processeur et mémoire à côté de la météo (module system).
    in property <bool> has-system;
    in property <SystemInfo> system;
    property <bool> system-hover;
    // Pilule telle qu'elle est dessinée (animations comprises) : avec le
    // flou, la région de la fenêtre la suit image par image.
    out property <length> pill-x: pill.x;
    out property <length> pill-y: pill.y;
    out property <length> pill-width: pill.width;
    out property <length> pill-height: pill.height;
    out property <length> pill-radius: pill.radius;
    out property <bool> pill-flat-top: root.top-offset <= 0;
    property <bool> weather-hover;
    // Mascotte : où elle se tient dans la pilule fermée (center | left |
    // right, vide : cachée), son humeur, sa saison, et si elle s'anime.
    in property <string> mascot-place;
    in property <string> mascot-mood: "idle";
    in property <bool> mascot-animated;
    in property <float> mascot-level;
    // Saison des décorations (vide : aucune).
    in property <string> season;
    // La pilule respire au rythme des basses (1 : taille normale).
    in property <float> pill-bounce: 1;
    // En appel ou en partage d'écran : point rouge dans la pilule.
    in property <bool> live;
    // Retour d'un geste dans l'île ouverte (« Volume 46 % »), à la place de la date.
    in property <string> toast;
    // Gestes : molette ou pavé tactile (déplacements en pixels logiques,
    // Maj enfoncée), glisser à la souris (déplacement horizontal), appui long.
    callback wheel(float, float, bool);
    callback drag(float);
    callback long-press();
    property <bool> long-fired;
    property <bool> dragged;
    // Place prise à droite de la pilule fermée par les points des non lues et
    // la lune.
    property <length> right-icons: root.unread-colors.length * 10px + (root.dnd ? 18px : 0px);
    // Couleurs d'état (charge, alerte) : les mêmes quel que soit le thème.
    property <color> ok-color: #30D158;
    property <color> alert-color: #FF453A;
    // Notifications des applications : celle annoncée, les dernières (onglet),
    // et les couleurs des non lues (points de la pilule au repos).
    in property <bool> has-notif;
    in property <NotifInfo> notif;
    in property <int> notif-seq;
    in property <bool> has-notif-tab;
    in property <[NotifInfo]> notif-rows;
    in property <int> notif-unread;
    in property <[color]> unread-colors;
    callback notif-action(string /* seen | clear | open:<id> | remove:<id> */);
    // Ne pas déranger : plus d'annonces ni de points, une lune sur la pilule.
    in property <bool> dnd;
    callback dnd-toggle();
    // Onglets de l'île ouverte : 0 accueil, 1 Claude, 2 notifications.
    changed tab => {
        if self.tab == 2 {
            root.notif-action("seen");
        }
    }

    // Animation d'arrivée : `popped` repasse à faux un instant à chaque
    // nouvelle notification, puis revient à vrai, ce qui rejoue les transitions.
    property <bool> popped: true;
    changed notif-seq => {
        self.popped = false;
        pop-timer.running = true;
    }
    pop-timer := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            self.running = false;
            root.popped = true;
        }
    }

    callback hover-changed(bool);
    callback clicked();
    callback claude-decide(string /* id */, string /* allow | deny | ask */);
    callback claude-focus(string /* session */);
    callback media-action(string /* toggle | next | prev | source */);
    callback media-seek(float /* 0..1 */);
    callback open-url(string);

    // Taille fixe de la fenêtre : la pilule grandit dedans, la zone cliquable
    // est restreinte à la pilule côté Win32.
    width: root.expanded-width;
    height: root.expanded-height + root.top-offset;

    pill := Rectangle {
        property <length> radius: root.expanded ? root.corner-radius : self.height / 2;
        // Collée en haut de l'écran : coins supérieurs carrés, façon encoche.
        property <length> top-radius: root.top-offset > 0 ? self.radius : 0;

        y: root.top-offset;
        x: (root.width - self.width) / 2;
        // Au rythme de la musique, la pilule fermée se resserre un peu entre
        // deux basses (jamais plus large que sa taille : la zone cliquable
        // reste la même).
        width: root.expanded ? root.expanded-width
            : (root.has-notif ? root.notif-width
            : root.has-attention ? root.attention-width : root.compact-width) - (1 - root.pill-bounce) * 5px;
        height: root.expanded ? root.expanded-height
            : root.has-notif ? root.notif-height
            : root.has-attention ? root.attention-height : root.compact-height;
        background: root.bg;
        // Sans contour dans le thème, un liseré à peine visible détache l'île
        // ouverte du fond.
        border-width: root.border.alpha > 0 || root.expanded ? 1px : 0px;
        border-color: root.border.alpha > 0 ? root.border : root.fg.with-alpha(root.expanded ? 0.09 : 0);
        animate border-color { duration: root.anim; }
        clip: true;
        border-top-left-radius: self.top-radius;
        border-top-right-radius: self.top-radius;
        border-bottom-left-radius: self.radius;
        border-bottom-right-radius: self.radius;

        animate width, height, radius { duration: root.anim; easing: ease-out-quint; }

        // Le contenu est dans la zone de survol : les boutons reçoivent leurs
        // clics sans faire perdre le survol à l'île.
        TouchArea {
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }
            clicked => {
                // Un appui long ou un glissement n'est pas un clic.
                if root.long-fired || root.dragged {
                    root.long-fired = false;
                    root.dragged = false;
                } else {
                    root.clicked();
                }
            }
            scroll-event(event) => {
                root.wheel(event.delta-x / 1px, event.delta-y / 1px, event.modifiers.shift);
                accept
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        root.long-fired = false;
                        root.dragged = false;
                        long-timer.running = true;
                    } else if event.kind == PointerEventKind.up {
                        long-timer.running = false;
                        if !root.long-fired && Math.abs(self.mouse-x - self.pressed-x) > 40px {
                            root.dragged = true;
                            root.drag((self.mouse-x - self.pressed-x) / 1px);
                        }
                    } else if event.kind == PointerEventKind.cancel {
                        long-timer.running = false;
                    }
                }
            }
            moved => {
                // Un glissement annule l'appui long.
                if Math.abs(self.mouse-x - self.pressed-x) > 8px {
                    long-timer.running = false;
                }
            }

            long-timer := Timer {
                interval: 600ms;
                running: false;
                triggered => {
                    self.running = false;
                    root.long-fired = true;
                    root.long-press();
                }
            }

            // Décorations de saison de l'île ouverte.
            SeasonDecor {
                season: root.season;
                opacity: root.expanded && !root.custom-view ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
            }

            // Île ouverte sur la musique : halo de la couleur de la pochette
            // (l'accent la suit) qui part du coin de la pochette.
            Rectangle {
                opacity: root.expanded && !root.custom-view && root.tab == 0 && root.has-media && !root.has-prompt ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim * 2; }
                background: @linear-gradient(160deg, root.accent.with-alpha(0.34) 0%, root.accent.with-alpha(0.1) 45%, transparent 75%);
            }

            // Nouvelle notification : la couleur de l'application monte du bas.
            Rectangle {
                opacity: root.has-notif && !root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
                background: @linear-gradient(180deg, transparent 35%, root.notif.tint.with-alpha(0.3) 100%);
            }

            // Trait lumineux qui s'étire le long du bord inférieur.
            Rectangle {
                y: parent.height - self.height;
                height: 2px;
                width: root.popped && root.has-notif && !root.expanded ? parent.width * 0.7 : 0px;
                x: (parent.width - self.width) / 2;
                background: @linear-gradient(90deg, transparent 0%, root.notif.tint 50%, transparent 100%);
                animate width { duration: root.popped ? 700ms : 0ms; easing: ease-out-quint; }
            }

            HorizontalLayout {
                padding-left: 11px;
                padding-right: 20px;
                spacing: 10px;
                opacity: root.has-notif && !root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim / 2; }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;

                    // Onde qui part de l'avatar.
                    Rectangle {
                        width: root.popped ? 62px : 36px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: root.notif.tint;
                        opacity: root.popped ? 0 : 0.9;
                        animate width, opacity { duration: root.popped ? 800ms : 0ms; easing: ease-out-quad; }
                    }

                    Avatar {
                        size: root.popped ? 36px : 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        initial: root.notif.initial;
                        tint: root.notif.tint;
                        has-icon: root.notif.has-icon;
                        icon: root.notif.icon;
                        animate size { duration: root.popped ? 550ms : 0ms; easing: ease-out-back; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: root.notif.app;
                            color: root.notif.tint;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: @tr("now");
                            color: root.fg.with-alpha(0.45);
                            font-size: 11px;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: root.notif.title != "" ? root.notif.title : root.notif.body;
                        color: root.fg;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    if root.notif.title != "" && root.notif.body != "": Text {
                        text: root.notif.body;
                        color: root.fg.with-alpha(0.7);
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }

            // Pilule fermée : un point par application aux notifications non lues.
            HorizontalLayout {
                alignment: end;
                padding-right: 14px;
                spacing: 4px;
                opacity: !root.expanded && !root.has-notif && root.unread-colors.length > 0 ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                for tint in root.unread-colors: Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: tint;
                }
            }

            // Ne pas déranger : une lune discrète à droite de la pilule fermée.
            Path {
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: root.fg.with-alpha(0.55);
                commands: "M 20.5 14.5 A 9 9 0 1 1 9.5 3.5 A 7 7 0 0 0 20.5 14.5 Z";
                opacity: root.dnd && !root.expanded && !root.has-notif ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
            }

            // En appel ou en partage d'écran : point rouge, à gauche des non lues.
            Rectangle {
                x: parent.width - 14px - root.right-icons - self.width;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.alert-color;
                drop-shadow-blur: 6px;
                drop-shadow-color: root.alert-color.with-alpha(0.8);
                opacity: root.live && !root.expanded && !root.has-notif ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
            }

            // Mascotte au centre de la pilule au repos, ou à droite quand la
            // musique occupe la pilule (pochette à gauche).
            if root.mascot-place == "center" || root.mascot-place == "right": Mascot {
                x: root.mascot-place == "center" ? (parent.width - self.width) / 2
                    : parent.width - 14px - root.right-icons - (root.live ? 14px : 0px) - self.width;
                y: (parent.height - self.height) / 2;
                mood: root.mascot-mood;
                season: root.season;
                animated: root.mascot-animated && !root.expanded;
                level: root.mascot-level;
                body-color: root.fg;
                eye-color: root.bg.with-alpha(1);
                accent: root.accent;
                opacity: !root.expanded && !root.has-notif ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
            }

            // Halloween : deux petites citrouilles autour de la mascotte.
            if root.mascot-place == "center" && root.season == "halloween": Rectangle {
                opacity: !root.expanded && !root.has-notif ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                Pumpkin {
                    x: parent.width / 2 - 30px;
                    y: (parent.height - self.height) / 2 + 3px;
                    size: 11px;
                }

                Pumpkin {
                    x: parent.width / 2 + 20px;
                    y: (parent.height - self.height) / 2 + 4px;
                    size: 9px;
                }
            }

            // Contenu compact : le module qui réclame l'attention.
            HorizontalLayout {
                padding-left: root.mascot-place == "left" ? 8px : 14px;
                // Laisse la place aux points des non lues, à la lune, au point
                // « en direct » et à la mascotte.
                padding-right: 14px + root.right-icons + (root.live ? 14px : 0px)
                    + (root.mascot-place == "right" ? 30px : 0px);
                spacing: 8px;
                opacity: root.has-attention && !root.has-notif && !root.expanded ? 1 : 0;
                animate opacity { duration: root.anim / 2; }

                // Claude en tête : la mascotte remplace le point.
                if root.mascot-place == "left": Mascot {
                    y: (parent.height - self.height) / 2;
                    mood: root.mascot-mood;
                    season: root.season;
                    animated: root.mascot-animated && !root.expanded;
                    level: root.mascot-level;
                    body-color: root.fg;
                    eye-color: root.bg.with-alpha(1);
                    accent: root.accent;
                }

                if root.mascot-place != "left" && !root.compact-art-visible && !root.compact-gauge-visible: Dot {
                    y: (parent.height - self.height) / 2;
                    background: root.urgent ? root.accent : root.fg.with-alpha(0.6);
                    drop-shadow-blur: root.urgent ? 8px : 0px;
                    drop-shadow-color: root.accent.with-alpha(0.9);
                }

                if root.compact-gauge-visible: Glyph {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    name: root.compact-gauge.icon;
                    ink: root.compact-gauge.charging ? root.ok-color
                        : root.compact-gauge.low ? root.alert-color : root.fg;
                }

                if root.compact-art-visible: Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.compact-art;
                        image-fit: cover;
                    }
                }

                Text {
                    text: root.attention-label;
                    color: root.fg;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.compact-gauge-visible && root.compact-gauge.level >= 0: BatteryGauge {
                    y: (parent.height - self.height) / 2;
                    level: root.compact-gauge.level / 100;
                    ink: root.fg;
                    fill: root.compact-gauge.charging ? root.ok-color
                        : root.compact-gauge.low ? root.alert-color : root.fg;
                }
            }

            // Vue personnelle de l'île ouverte (layouts/<nom>.slint, voir la doc).
            if root.custom-view: Rectangle {
                opacity: root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                ComponentContainer {
                    x: 0;
                    y: root.top-offset;
                    width: parent.width;
                    height: parent.height - root.top-offset;
                    component-factory: root.custom-view-factory;
                }
            }

            // Contenu ouvert : en-tête commun (heure, onglets), puis l'onglet choisi.
            if !root.custom-view: VerticalLayout {
                padding: 16px;
                padding-top: 10px + root.top-offset / 2;
                padding-bottom: 10px;
                spacing: 8px;
                opacity: root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                HorizontalLayout {
                    spacing: 10px;
                    height: 24px;

                    Text {
                        text: root.time-text;
                        color: root.fg;
                        font-size: 17px;
                        font-weight: 700;
                        letter-spacing: -0.3px;
                        vertical-alignment: center;
                    }

                    // Météo : pictogramme et température ; le survol montre le détail.
                    // (La zone de survol enveloppe le layout : placée dedans,
                    // elle y prendrait sa propre case.)
                    if root.has-weather: TouchArea {
                        changed has-hover => {
                            root.weather-hover = self.has-hover;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            Glyph {
                                width: 15px;
                                height: 15px;
                                y: (parent.height - self.height) / 2;
                                name: root.weather.icon;
                                ink: root.fg.with-alpha(0.85);
                            }

                            Text {
                                text: root.weather.temperature;
                                color: root.fg.with-alpha(0.85);
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Processeur et mémoire ; le survol montre le détail.
                    if root.has-system: TouchArea {
                        changed has-hover => {
                            root.system-hover = self.has-hover;
                        }

                        HorizontalLayout {
                            spacing: 3px;

                            Glyph {
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                                name: "cpu";
                                ink: root.system.cpu-hot ? root.alert-color : root.fg.with-alpha(0.7);
                            }

                            Text {
                                text: root.system.cpu;
                                min-width: 27px;
                                color: root.system.cpu-hot ? root.alert-color : root.fg.with-alpha(0.85);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Glyph {
                                width: 13px;
                                height: 13px;
                                y: (parent.height - self.height) / 2;
                                name: "memory";
                                ink: root.system.ram-hot ? root.alert-color : root.fg.with-alpha(0.7);
                            }

                            Text {
                                text: root.system.ram;
                                min-width: 27px;
                                color: root.system.ram-hot ? root.alert-color : root.fg.with-alpha(0.85);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.toast != "" ? root.toast : root.weather-hover ? root.weather.detail
                            : root.system-hover ? root.system.detail : root.date-text;
                        color: root.toast != "" ? root.fg : root.fg.with-alpha(0.5);
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Visualiseur audio (désactivé par défaut) : barres d'équaliseur.
                    if root.tab == 0 && root.viz-bars.length > 0 && root.has-media: HorizontalLayout {
                        spacing: 2px;
                        alignment: end;
                        height: 14px;
                        y: (parent.height - self.height) / 2;

                        for level in root.viz-bars: Rectangle {
                            width: 3px;
                            y: parent.height - self.height;
                            height: max(2px, 14px * clamp(level, 0, 1));
                            border-radius: 1.5px;
                            background: root.accent;
                        }
                    }

                    // Source de la musique ; cliquable s'il y en a plusieurs.
                    if root.tab == 0 && root.has-media: Text {
                        text: root.media.multi-source ? root.media.source + "  ⇄" : root.media.source;
                        color: source-ta.has-hover && root.media.multi-source ? root.fg : root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;

                        source-ta := TouchArea {
                            enabled: root.media.multi-source;
                            clicked => { root.media-action("source"); }
                        }
                    }

                    if root.tab == 2 && root.notif-rows.length > 0: Text {
                        text: @tr("Clear all");
                        color: clear-ta.has-hover ? root.accent : root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;

                        clear-ta := TouchArea {
                            clicked => { root.notif-action("clear"); }
                        }
                    }

                    // Contrôle segmenté : un indicateur glisse sous l'onglet choisi.
                    if root.has-notif-tab || root.has-claude-tab: Rectangle {
                        property <int> slot: root.tab == 0 ? 0 : root.tab == 2 ? 1 : root.has-notif-tab ? 2 : 1;
                        width: tabs.preferred-width;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 12px;
                        background: root.fg.with-alpha(0.07);

                        Rectangle {
                            x: 1px + parent.slot * 62px;
                            y: 1px;
                            width: 62px;
                            height: 22px;
                            border-radius: 11px;
                            background: root.fg.with-alpha(0.16);
                            animate x { duration: root.anim; easing: ease-out-quint; }
                        }

                        tabs := HorizontalLayout {
                            padding: 1px;

                            TabChip {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Home");
                                active: root.tab == 0;
                                ink: root.fg;
                                accent: root.accent;
                                clicked => { root.tab = 0; }
                            }

                            if root.has-notif-tab: TabChip {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Notifs");
                                active: root.tab == 2;
                                badge: root.notif-unread;
                                ink: root.fg;
                                accent: root.accent;
                                clicked => { root.tab = 2; }
                            }

                            if root.has-claude-tab: TabChip {
                                y: (parent.height - self.height) / 2;
                                text: "Claude";
                                active: root.tab == 1;
                                ink: root.fg;
                                accent: root.accent;
                                clicked => { root.tab = 1; }
                            }
                        }
                    }

                    // Ne pas déranger (lune pleine et colorée quand il est actif).
                    if root.has-notif-tab: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        icon: "moon";
                        ink: root.dnd ? root.accent : root.fg.with-alpha(0.55);
                        clicked => { root.dnd-toggle(); }
                    }
                }

                // Accueil : musique, Claude, minuteur, étagère, agenda…
                if root.tab == 0: VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    vertical-stretch: 1;

                    // Lecteur (masqué pendant une demande de permission, prioritaire).
                    if root.has-media && !root.has-prompt: HorizontalLayout {
                        height: 58px;
                        spacing: 12px;

                        Rectangle {
                            width: 58px;
                            height: 58px;
                            border-radius: 12px;
                            clip: true;
                            // Halo de la couleur de la pochette.
                            drop-shadow-blur: 18px;
                            drop-shadow-color: root.media.has-art ? root.accent.with-alpha(0.5) : transparent;
                            background: root.fg.with-alpha(0.08);

                            if root.media.has-art: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.media.art;
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.media.title;
                                color: root.fg;
                                font-size: 15px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: root.media.artist;
                                color: root.fg.with-alpha(0.55);
                                font-size: 12px;
                                overflow: elide;
                            }

                            if root.media.has-timeline: HorizontalLayout {
                                spacing: 6px;
                                padding-top: 4px;

                                Text {
                                    text: root.media.position;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                bar := Rectangle {
                                    height: 12px;
                                    horizontal-stretch: 1;

                                    property <bool> grab: bar-ta.has-hover && root.media.can-seek;

                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: bar.grab ? 6px : 4px;
                                        border-radius: self.height / 2;
                                        background: root.fg.with-alpha(0.14);
                                        animate height { duration: 120ms; }
                                    }

                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width * clamp(root.media.progress, 0, 1);
                                        height: bar.grab ? 6px : 4px;
                                        border-radius: self.height / 2;
                                        background: @linear-gradient(90deg, root.accent.with-alpha(0.7) 0%, root.accent 100%);
                                        animate height { duration: 120ms; }
                                    }

                                    // Curseur au survol, là où la lecture en est.
                                    Rectangle {
                                        width: bar.grab ? 12px : 0px;
                                        height: self.width;
                                        x: parent.width * clamp(root.media.progress, 0, 1) - self.width / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: root.fg;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: root.bg.with-alpha(0.5);
                                        animate width { duration: 120ms; }
                                    }

                                    bar-ta := TouchArea {
                                        enabled: root.media.can-seek;
                                        clicked => { root.media-seek(self.mouse-x / self.width); }
                                    }
                                }

                                Text {
                                    text: root.media.duration;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 0;

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "previous";
                                ink: root.fg;
                                enabled: root.media.can-previous;
                                clicked => { root.media-action("prev"); }
                            }

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                size: 38px;
                                filled: true;
                                hole: root.bg.with-alpha(1);
                                icon: root.media.playing ? "pause" : "play";
                                ink: root.fg;
                                enabled: root.media.can-toggle;
                                clicked => { root.media-action("toggle"); }
                            }

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "next";
                                ink: root.fg;
                                enabled: root.media.can-next;
                                clicked => { root.media-action("next"); }
                            }
                        }
                    }

                    // Demande de permission de Claude Code.
                    if root.has-prompt: VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: @tr("{} wants to use {}", root.prompt.project, root.prompt.tool);
                            color: root.accent;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.prompt.detail;
                            color: root.fg.with-alpha(0.75);
                            font-size: 12px;
                            font-family: "Consolas";
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            PillButton {
                                text: @tr("Allow");
                                fill: root.accent;
                                ink: root.bg;
                                clicked => { root.claude-decide(root.prompt.id, "allow"); }
                            }

                            PillButton {
                                text: @tr("Deny");
                                fill: root.fg.with-alpha(0.09);
                                ink: root.fg;
                                clicked => { root.claude-decide(root.prompt.id, "deny"); }
                            }

                            PillButton {
                                text: @tr("Terminal");
                                fill: transparent;
                                ink: root.fg.with-alpha(0.8);
                                line: root.fg.with-alpha(0.25);
                                clicked => { root.claude-decide(root.prompt.id, "ask"); }
                            }
                        }
                    }

                    // Minuteur : durées prédéfinies, compte à rebours, pause.
                    if !root.has-prompt && root.has-timer: HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        padding-left: 6px;

                        Text {
                            text: root.timer.phase == 0 ? @tr("Timer")
                                : root.timer.phase == 3 ? @tr("Time's up!") : root.timer.time;
                            color: root.timer.phase == 0 ? root.fg.with-alpha(0.7) : root.accent;
                            font-size: root.timer.phase == 0 ? 12px : 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                            min-width: 64px;
                        }

                        if root.timer.phase == 0: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            horizontal-stretch: 1;

                            for minutes in root.timer.presets: PillButton {
                                grow: false;
                                min-width: 64px;
                                text: @tr("{} min", minutes);
                                fill: root.fg.with-alpha(0.09);
                                ink: root.fg;
                                clicked => { root.timer-action("start:" + minutes); }
                            }
                        }

                        if root.timer.phase == 1 || root.timer.phase == 2: Rectangle {
                            horizontal-stretch: 1;
                            height: 12px;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.fg.with-alpha(0.15);
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: parent.width * clamp(root.timer.progress, 0, 1);
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.accent;
                            }
                        }

                        if root.timer.phase == 1: PillButton {
                            text: @tr("Pause");
                            fill: root.fg.with-alpha(0.09);
                            ink: root.fg;
                            clicked => { root.timer-action("pause"); }
                        }

                        if root.timer.phase == 2: PillButton {
                            text: @tr("Resume");
                            fill: root.accent;
                            ink: root.bg;
                            clicked => { root.timer-action("resume"); }
                        }

                        if root.timer.phase == 1 || root.timer.phase == 2: PillButton {
                            text: @tr("Reset");
                            fill: transparent;
                            ink: root.fg.with-alpha(0.8);
                            line: root.fg.with-alpha(0.25);
                            clicked => { root.timer-action("reset"); }
                        }

                        if root.timer.phase == 3: PillButton {
                            text: @tr("OK");
                            fill: root.accent;
                            ink: root.bg;
                            clicked => { root.timer-action("reset"); }
                        }
                    }

                    // Plugins WASM : une ligne de texte par plugin.
                    if !root.has-prompt && root.plugin-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for plugin in root.plugin-rows: Rectangle {
                            height: 22px;

                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 8px;

                                Text {
                                    text: plugin.name;
                                    color: root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    min-width: 64px;
                                }

                                Text {
                                    text: plugin.text;
                                    color: plugin.attention > 0 ? root.accent : root.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // Étagère : fichiers déposés sur l'île, un clic les ouvre.
                    if !root.has-prompt && root.shelf-rows.length > 0: HorizontalLayout {
                        height: 28px;
                        spacing: 6px;
                        padding-left: 6px;

                        Text {
                            text: @tr("Shelf");
                            color: root.fg.with-alpha(0.7);
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            min-width: 64px;
                        }

                        for item[i] in root.shelf-rows: Rectangle {
                            horizontal-stretch: 1;
                            height: 24px;
                            border-radius: 12px;
                            background: chip-ta.has-hover ? root.fg.with-alpha(0.2) : root.fg.with-alpha(0.12);

                            chip-ta := TouchArea {
                                clicked => { root.shelf-open(i); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 2px;
                                spacing: 2px;

                                Text {
                                    text: item.name;
                                    color: root.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 20px;
                                    Text {
                                        text: "×";
                                        color: root.fg.with-alpha(0.7);
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.shelf-remove(i); }
                                    }
                                }
                            }
                        }

                        if root.shelf-more != "": Text {
                            text: root.shelf-more;
                            color: root.fg.with-alpha(0.6);
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    // Agenda : prochaines réunions, bouton « Rejoindre ».
                    if !root.has-prompt && root.agenda-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for item in root.agenda-rows: Rectangle {
                            height: 24px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 2px;
                                spacing: 8px;

                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    background: item.soon ? root.accent : root.fg.with-alpha(0.35);
                                }

                                Text {
                                    text: item.time;
                                    color: item.soon ? root.accent : root.fg.with-alpha(0.7);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                if item.location != "": Text {
                                    text: item.location;
                                    color: root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: item.title;
                                    color: root.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if item.relative != "": Text {
                                    text: item.relative;
                                    color: item.soon ? root.accent : root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                if item.has-join: Rectangle {
                                    width: join-label.preferred-width + 16px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 10px;
                                    background: join-ta.has-hover ? root.accent.brighter(0.15) : root.accent;

                                    join-label := Text {
                                        text: @tr("Join");
                                        color: root.bg;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    join-ta := TouchArea {
                                        clicked => { root.open-url(item.join-url); }
                                    }
                                }
                            }
                        }
                    }

                    // Sessions Claude Code en cours (clic : ramène le terminal).
                    if !root.has-prompt && root.claude-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for row in root.claude-rows: Rectangle {
                            height: 24px;
                            border-radius: 6px;
                            background: row-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;

                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    background: row.urgent ? root.accent
                                        : row.active ? root.fg.with-alpha(0.7) : root.fg.with-alpha(0.25);
                                }

                                Text {
                                    text: row.project;
                                    color: root.fg;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: row.status;
                                    color: row.urgent ? root.accent : root.fg.with-alpha(0.6);
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            row-ta := TouchArea {
                                clicked => { root.claude-focus(row.id); }
                            }
                        }
                    }

                    if !root.has-prompt && !root.has-media && root.claude-rows.length == 0 && root.agenda-rows.length == 0: Text {
                        text: root.has-attention ? root.attention-label : @tr("All quiet");
                        color: root.has-attention && root.urgent ? root.accent : root.fg.with-alpha(0.75);
                        font-size: 14px;
                        overflow: elide;
                    }
                }

                // Onglet Claude : consommation estimée et conversations récentes.
                if root.tab == 1: VerticalLayout {
                    spacing: 3px;
                    alignment: start;
                    vertical-stretch: 1;

                    Text {
                        text: root.usage-text;
                        color: root.fg.with-alpha(0.8);
                        font-size: 12px;
                        overflow: elide;
                    }

                    if root.usage-has-limit: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: root.fg.with-alpha(0.15);

                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.usage-ratio, 0, 1);
                            border-radius: 2px;
                            background: root.usage-ratio > 0.85 ? root.alert-color : root.accent;
                        }
                    }

                    for item in root.recent-rows: Rectangle {
                        height: 20px;
                        border-radius: 6px;
                        background: recent-ta.has-hover ? root.fg.with-alpha(0.12) : transparent;

                        recent-ta := TouchArea {
                            clicked => { root.recent-open(item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;

                            Text {
                                text: item.title;
                                color: root.fg;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: item.meta;
                                color: root.fg.with-alpha(0.5);
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    if root.recent-rows.length == 0: Text {
                        text: @tr("No conversation found");
                        color: root.fg.with-alpha(0.5);
                        font-size: 12px;
                    }
                }

                // Onglet des notifications : les dernières, un clic ouvre l'application.
                if root.tab == 2: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    vertical-stretch: 1;

                    if root.dnd: Text {
                        height: 22px;
                        text: @tr("Do not disturb: notifications arrive here without popping up");
                        color: root.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    for item in root.notif-rows: Rectangle {
                        height: 26px;
                        border-radius: 8px;
                        background: notif-ta.has-hover || close-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;

                        notif-ta := TouchArea {
                            clicked => { root.notif-action("open:" + item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 8px;

                            Avatar {
                                size: 18px;
                                y: (parent.height - self.height) / 2;
                                initial: item.initial;
                                tint: item.tint;
                                has-icon: item.has-icon;
                                icon: item.icon;
                            }

                            Text {
                                text: item.app;
                                color: item.tint;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            if item.title != "": Text {
                                text: item.title;
                                color: root.fg;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 140px;
                            }

                            Text {
                                text: item.body;
                                color: root.fg.with-alpha(0.6);
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: item.ago;
                                color: root.fg.with-alpha(0.45);
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 18px;
                                opacity: notif-ta.has-hover || close-ta.has-hover ? 1 : 0;

                                Text {
                                    text: "×";
                                    color: close-ta.has-hover ? root.accent : root.fg.with-alpha(0.7);
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                close-ta := TouchArea {
                                    clicked => { root.notif-action("remove:" + item.id); }
                                }
                            }
                        }
                    }

                    if root.notif-rows.length == 0: Text {
                        text: @tr("No notifications");
                        color: root.fg.with-alpha(0.5);
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
