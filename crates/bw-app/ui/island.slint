// L'île : une pilule en haut-centre de l'écran, dans une fenêtre transparente
// fixe dimensionnée pour l'état ouvert. Toute la logique (quand ouvrir, quoi
// afficher) vit côté Rust ; ce fichier ne fait que dessiner l'état reçu.
//
// Seules les transitions déclenchent un rendu : aucune animation en boucle,
// pour rester à ~0 % CPU au repos.

export struct ClaudeRow {
    id: string,
    project: string,
    status: string,
    urgent: bool,
    active: bool,
}

export struct ClaudePrompt {
    id: string,
    project: string,
    tool: string,
    detail: string,
}

export struct AgendaRow {
    title: string,
    time: string,
    location: string,
    relative: string,
    join-url: string,
    has-join: bool,
    soon: bool,
}

export struct RecentRow {
    id: string,
    title: string,
    meta: string,
}

export struct PluginRow {
    name: string,
    text: string,
    attention: int,
}

export struct ShelfRow {
    name: string,
    path: string,
}

export struct TimerInfo {
    /// 0 prêt, 1 en cours, 2 en pause, 3 terminé.
    phase: int,
    time: string,
    progress: float,
    presets: [string],
}

export struct MediaInfo {
    title: string,
    artist: string,
    source: string,
    playing: bool,
    can-previous: bool,
    can-next: bool,
    can-toggle: bool,
    can-seek: bool,
    has-art: bool,
    art: image,
    has-timeline: bool,
    position: string,
    duration: string,
    progress: float,
    multi-source: bool,
}

export struct NotifInfo {
    id: int,
    app: string,
    title: string,
    body: string,
    tint: color,
    initial: string,
    ago: string,
}

// Icônes dessinées (pas de police d'icônes à embarquer), viewbox 24x24.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <bool> enabled: true;
    in property <length> size: 30px;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.has-hover && root.enabled ? root.ink.with-alpha(0.12) : transparent;
    opacity: root.enabled ? 1 : 0.3;

    Path {
        width: root.size * 0.6;
        height: root.size * 0.6;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: root.icon == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon == "pause" ? "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"
            : root.icon == "next" ? "M 4 5 L 14 12 L 4 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : "M 20 5 L 10 12 L 20 19 Z M 6 5 L 9 5 L 9 19 L 6 19 Z";
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Dot inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <color> fill;
    in property <color> ink;
    in property <color> line: transparent;
    callback clicked;

    height: 28px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 1;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.line;
    background: ta.pressed ? root.fill.darker(0.2) : ta.has-hover ? root.fill.brighter(0.15) : root.fill;

    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pastille ronde à l'initiale de l'application, à sa couleur.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 36px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: @radial-gradient(circle, root.tint.brighter(0.35) 0%, root.tint 100%);

    Text {
        text: root.initial;
        color: white;
        font-size: root.size * 0.46;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TabChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <int> badge;
    in property <color> ink;
    in property <color> accent;
    callback clicked;

    width: row.preferred-width;
    height: 22px;
    border-radius: 11px;
    background: root.active ? root.ink.with-alpha(0.16)
        : ta.has-hover ? root.ink.with-alpha(0.08) : transparent;
    animate background { duration: 150ms; }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;

        Text {
            text: root.text;
            color: root.active ? root.ink : root.ink.with-alpha(0.6);
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }

        if root.badge > 0: Rectangle {
            width: max(14px, count.preferred-width + 8px);
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: root.accent;

            count := Text {
                text: root.badge > 9 ? "9+" : "\{root.badge}";
                color: white;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Island inherits Window {
    title: "BoringWindows";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // --- Thème (depuis config.toml) ---
    in property <length> compact-width: 190px;
    in property <length> compact-height: 32px;
    in property <length> attention-width: 300px;
    in property <length> attention-height: 36px;
    in property <length> expanded-width: 520px;
    in property <length> expanded-height: 170px;
    // Pilule qui annonce une notification (calculée côté Rust).
    in property <length> notif-width: 380px;
    in property <length> notif-height: 58px;
    in property <length> corner-radius: 22px;
    in property <length> top-offset: 0px;
    in property <duration> anim: 240ms;
    in property <color> bg: black;
    in property <color> fg: white;
    in property <color> accent: #ff8a3d;
    in property <color> border: transparent;
    // Police ; vide : celle du système.
    in property <string> font;
    default-font-family: root.font;

    // --- État ---
    in property <bool> expanded;
    in property <bool> has-attention;
    in property <bool> urgent;
    in property <string> attention-label;
    in property <string> time-text: "--:--";
    in property <string> date-text;
    in property <[ClaudeRow]> claude-rows;
    in property <bool> has-prompt;
    in property <ClaudePrompt> prompt;
    in property <bool> has-media;
    in property <MediaInfo> media;
    in property <[AgendaRow]> agenda-rows;
    // Onglet Claude : consommation estimée et conversations récentes.
    in property <bool> has-claude-tab;
    in-out property <int> tab;
    in property <[RecentRow]> recent-rows;
    in property <string> usage-text;
    in property <float> usage-ratio;
    in property <bool> usage-has-limit;
    callback recent-open(string /* id de session */);
    changed expanded => {
        if !self.expanded {
            self.tab = 0;
        }
    }
    in property <[float]> viz-bars;
    in property <[PluginRow]> plugin-rows;
    in property <[ShelfRow]> shelf-rows;
    in property <string> shelf-more;
    callback shelf-open(int);
    callback shelf-remove(int);
    in property <bool> custom-view;
    in property <component-factory> custom-view-factory;
    in property <bool> has-timer;
    in property <TimerInfo> timer;
    callback timer-action(string /* start:<min> | pause | resume | reset */);
    in property <bool> compact-art-visible;
    in property <image> compact-art;
    // Notifications des applications : celle annoncée, les dernières (onglet),
    // et les couleurs des non lues (points de la pilule au repos).
    in property <bool> has-notif;
    in property <NotifInfo> notif;
    in property <int> notif-seq;
    in property <bool> has-notif-tab;
    in property <[NotifInfo]> notif-rows;
    in property <int> notif-unread;
    in property <[color]> unread-colors;
    callback notif-action(string /* seen | clear | open:<id> | remove:<id> */);
    // Onglets de l'île ouverte : 0 accueil, 1 Claude, 2 notifications.
    changed tab => {
        if self.tab == 2 {
            root.notif-action("seen");
        }
    }

    // Animation d'arrivée : `popped` repasse à faux un instant à chaque
    // nouvelle notification, puis revient à vrai, ce qui rejoue les transitions.
    property <bool> popped: true;
    changed notif-seq => {
        self.popped = false;
        pop-timer.running = true;
    }
    pop-timer := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            self.running = false;
            root.popped = true;
        }
    }

    callback hover-changed(bool);
    callback clicked();
    callback claude-decide(string /* id */, string /* allow | deny | ask */);
    callback claude-focus(string /* session */);
    callback media-action(string /* toggle | next | prev | source */);
    callback media-seek(float /* 0..1 */);
    callback open-url(string);

    // Taille fixe de la fenêtre : la pilule grandit dedans, la zone cliquable
    // est restreinte à la pilule côté Win32.
    width: root.expanded-width;
    height: root.expanded-height + root.top-offset;

    pill := Rectangle {
        property <length> radius: root.expanded ? root.corner-radius : self.height / 2;
        // Collée en haut de l'écran : coins supérieurs carrés, façon encoche.
        property <length> top-radius: root.top-offset > 0 ? self.radius : 0;

        y: root.top-offset;
        x: (root.width - self.width) / 2;
        width: root.expanded ? root.expanded-width
            : root.has-notif ? root.notif-width
            : root.has-attention ? root.attention-width : root.compact-width;
        height: root.expanded ? root.expanded-height
            : root.has-notif ? root.notif-height
            : root.has-attention ? root.attention-height : root.compact-height;
        background: root.bg;
        border-width: root.border.alpha > 0 ? 1px : 0px;
        border-color: root.border;
        clip: true;
        border-top-left-radius: self.top-radius;
        border-top-right-radius: self.top-radius;
        border-bottom-left-radius: self.radius;
        border-bottom-right-radius: self.radius;

        animate width, height, radius { duration: root.anim; easing: ease-out-quint; }

        // Le contenu est dans la zone de survol : les boutons reçoivent leurs
        // clics sans faire perdre le survol à l'île.
        TouchArea {
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }
            clicked => {
                root.clicked();
            }

            // Nouvelle notification : la couleur de l'application monte du bas.
            Rectangle {
                opacity: root.has-notif && !root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }
                background: @linear-gradient(180deg, transparent 35%, root.notif.tint.with-alpha(0.3) 100%);
            }

            // Trait lumineux qui s'étire le long du bord inférieur.
            Rectangle {
                y: parent.height - self.height;
                height: 2px;
                width: root.popped && root.has-notif && !root.expanded ? parent.width * 0.7 : 0px;
                x: (parent.width - self.width) / 2;
                background: @linear-gradient(90deg, transparent 0%, root.notif.tint 50%, transparent 100%);
                animate width { duration: root.popped ? 700ms : 0ms; easing: ease-out-quint; }
            }

            HorizontalLayout {
                padding-left: 11px;
                padding-right: 20px;
                spacing: 10px;
                opacity: root.has-notif && !root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim / 2; }

                Rectangle {
                    width: 36px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;

                    // Onde qui part de l'avatar.
                    Rectangle {
                        width: root.popped ? 62px : 36px;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: root.notif.tint;
                        opacity: root.popped ? 0 : 0.9;
                        animate width, opacity { duration: root.popped ? 800ms : 0ms; easing: ease-out-quad; }
                    }

                    Avatar {
                        size: root.popped ? 36px : 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        initial: root.notif.initial;
                        tint: root.notif.tint;
                        animate size { duration: root.popped ? 550ms : 0ms; easing: ease-out-back; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: root.notif.app;
                            color: root.notif.tint;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                        }

                        Text {
                            text: @tr("now");
                            color: root.fg.with-alpha(0.45);
                            font-size: 11px;
                            horizontal-stretch: 1;
                        }
                    }

                    Text {
                        text: root.notif.title != "" ? root.notif.title : root.notif.body;
                        color: root.fg;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    if root.notif.title != "" && root.notif.body != "": Text {
                        text: root.notif.body;
                        color: root.fg.with-alpha(0.7);
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }

            // Pilule fermée : un point par application aux notifications non lues.
            HorizontalLayout {
                alignment: end;
                padding-right: 14px;
                spacing: 4px;
                opacity: !root.expanded && !root.has-notif && root.unread-colors.length > 0 ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                for tint in root.unread-colors: Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: tint;
                }
            }

            // Contenu compact : le module qui réclame l'attention.
            HorizontalLayout {
                padding-left: 14px;
                // Laisse la place aux points des notifications non lues.
                padding-right: 14px + root.unread-colors.length * 10px;
                spacing: 8px;
                opacity: root.has-attention && !root.has-notif && !root.expanded ? 1 : 0;
                animate opacity { duration: root.anim / 2; }

                if !root.compact-art-visible: Dot {
                    y: (parent.height - self.height) / 2;
                    background: root.urgent ? root.accent : root.fg.with-alpha(0.6);
                }

                if root.compact-art-visible: Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.compact-art;
                        image-fit: cover;
                    }
                }

                Text {
                    text: root.attention-label;
                    color: root.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Vue personnelle de l'île ouverte (layouts/<nom>.slint, voir la doc).
            if root.custom-view: Rectangle {
                opacity: root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                ComponentContainer {
                    x: 0;
                    y: root.top-offset;
                    width: parent.width;
                    height: parent.height - root.top-offset;
                    component-factory: root.custom-view-factory;
                }
            }

            // Contenu ouvert : en-tête commun (heure, onglets), puis l'onglet choisi.
            if !root.custom-view: VerticalLayout {
                padding: 16px;
                padding-top: 10px + root.top-offset / 2;
                padding-bottom: 10px;
                spacing: 8px;
                opacity: root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                HorizontalLayout {
                    spacing: 10px;
                    height: 24px;

                    Text {
                        text: root.time-text;
                        color: root.fg;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.date-text;
                        color: root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Visualiseur audio (désactivé par défaut) : barres d'équaliseur.
                    if root.tab == 0 && root.viz-bars.length > 0 && root.has-media: HorizontalLayout {
                        spacing: 2px;
                        alignment: end;
                        height: 14px;
                        y: (parent.height - self.height) / 2;

                        for level in root.viz-bars: Rectangle {
                            width: 3px;
                            y: parent.height - self.height;
                            height: max(2px, 14px * clamp(level, 0, 1));
                            border-radius: 1.5px;
                            background: root.accent;
                        }
                    }

                    // Source de la musique ; cliquable s'il y en a plusieurs.
                    if root.tab == 0 && root.has-media: Text {
                        text: root.media.multi-source ? root.media.source + "  ⇄" : root.media.source;
                        color: source-ta.has-hover && root.media.multi-source ? root.fg : root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;

                        source-ta := TouchArea {
                            enabled: root.media.multi-source;
                            clicked => { root.media-action("source"); }
                        }
                    }

                    if root.tab == 2 && root.notif-rows.length > 0: Text {
                        text: @tr("Clear all");
                        color: clear-ta.has-hover ? root.accent : root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;

                        clear-ta := TouchArea {
                            clicked => { root.notif-action("clear"); }
                        }
                    }

                    if root.has-notif-tab || root.has-claude-tab: HorizontalLayout {
                        spacing: 2px;

                        TabChip {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Home");
                            active: root.tab == 0;
                            ink: root.fg;
                            accent: root.accent;
                            clicked => { root.tab = 0; }
                        }

                        if root.has-notif-tab: TabChip {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Notifs");
                            active: root.tab == 2;
                            badge: root.notif-unread;
                            ink: root.fg;
                            accent: root.accent;
                            clicked => { root.tab = 2; }
                        }

                        if root.has-claude-tab: TabChip {
                            y: (parent.height - self.height) / 2;
                            text: "Claude";
                            active: root.tab == 1;
                            ink: root.fg;
                            accent: root.accent;
                            clicked => { root.tab = 1; }
                        }
                    }
                }

                // Accueil : musique, Claude, minuteur, étagère, agenda…
                if root.tab == 0: VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    vertical-stretch: 1;

                    // Lecteur (masqué pendant une demande de permission, prioritaire).
                    if root.has-media && !root.has-prompt: HorizontalLayout {
                        height: 56px;
                        spacing: 12px;

                        Rectangle {
                            width: 56px;
                            height: 56px;
                            border-radius: 8px;
                            clip: true;
                            // Halo de la couleur de la pochette.
                            drop-shadow-blur: 14px;
                            drop-shadow-color: root.media.has-art ? root.accent.with-alpha(0.45) : transparent;
                            background: root.fg.with-alpha(0.08);

                            if root.media.has-art: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.media.art;
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: root.media.title;
                                color: root.fg;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: root.media.artist;
                                color: root.fg.with-alpha(0.6);
                                font-size: 12px;
                                overflow: elide;
                            }

                            if root.media.has-timeline: HorizontalLayout {
                                spacing: 6px;
                                padding-top: 4px;

                                Text {
                                    text: root.media.position;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                bar := Rectangle {
                                    height: 12px;
                                    horizontal-stretch: 1;

                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: bar-ta.has-hover && root.media.can-seek ? 5px : 3px;
                                        border-radius: self.height / 2;
                                        background: root.fg.with-alpha(0.15);
                                    }

                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width * clamp(root.media.progress, 0, 1);
                                        height: bar-ta.has-hover && root.media.can-seek ? 5px : 3px;
                                        border-radius: self.height / 2;
                                        background: root.accent;
                                    }

                                    bar-ta := TouchArea {
                                        enabled: root.media.can-seek;
                                        clicked => { root.media-seek(self.mouse-x / self.width); }
                                    }
                                }

                                Text {
                                    text: root.media.duration;
                                    color: root.fg.with-alpha(0.5);
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 0;

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "previous";
                                ink: root.fg;
                                enabled: root.media.can-previous;
                                clicked => { root.media-action("prev"); }
                            }

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                size: 36px;
                                icon: root.media.playing ? "pause" : "play";
                                ink: root.fg;
                                enabled: root.media.can-toggle;
                                clicked => { root.media-action("toggle"); }
                            }

                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "next";
                                ink: root.fg;
                                enabled: root.media.can-next;
                                clicked => { root.media-action("next"); }
                            }
                        }
                    }

                    // Demande de permission de Claude Code.
                    if root.has-prompt: VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: @tr("{} wants to use {}", root.prompt.project, root.prompt.tool);
                            color: root.accent;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.prompt.detail;
                            color: root.fg.with-alpha(0.75);
                            font-size: 12px;
                            font-family: "Consolas";
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            PillButton {
                                text: @tr("Allow");
                                fill: root.accent;
                                ink: root.bg;
                                clicked => { root.claude-decide(root.prompt.id, "allow"); }
                            }

                            PillButton {
                                text: @tr("Deny");
                                fill: root.fg.with-alpha(0.12);
                                ink: root.fg;
                                clicked => { root.claude-decide(root.prompt.id, "deny"); }
                            }

                            PillButton {
                                text: @tr("Terminal");
                                fill: transparent;
                                ink: root.fg.with-alpha(0.8);
                                line: root.fg.with-alpha(0.25);
                                clicked => { root.claude-decide(root.prompt.id, "ask"); }
                            }
                        }
                    }

                    // Minuteur : durées prédéfinies, compte à rebours, pause.
                    if !root.has-prompt && root.has-timer: HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        padding-left: 6px;

                        Text {
                            text: root.timer.phase == 0 ? @tr("Timer")
                                : root.timer.phase == 3 ? @tr("Time's up!") : root.timer.time;
                            color: root.timer.phase == 0 ? root.fg.with-alpha(0.7) : root.accent;
                            font-size: root.timer.phase == 0 ? 12px : 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                            min-width: 64px;
                        }

                        if root.timer.phase == 0: HorizontalLayout {
                            spacing: 6px;

                            for minutes in root.timer.presets: PillButton {
                                text: @tr("{} min", minutes);
                                fill: root.fg.with-alpha(0.12);
                                ink: root.fg;
                                clicked => { root.timer-action("start:" + minutes); }
                            }
                        }

                        if root.timer.phase == 1 || root.timer.phase == 2: Rectangle {
                            horizontal-stretch: 1;
                            height: 12px;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.fg.with-alpha(0.15);
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: parent.width * clamp(root.timer.progress, 0, 1);
                                height: 3px;
                                border-radius: 1.5px;
                                background: root.accent;
                            }
                        }

                        if root.timer.phase == 1: PillButton {
                            text: @tr("Pause");
                            fill: root.fg.with-alpha(0.12);
                            ink: root.fg;
                            clicked => { root.timer-action("pause"); }
                        }

                        if root.timer.phase == 2: PillButton {
                            text: @tr("Resume");
                            fill: root.accent;
                            ink: root.bg;
                            clicked => { root.timer-action("resume"); }
                        }

                        if root.timer.phase == 1 || root.timer.phase == 2: PillButton {
                            text: @tr("Reset");
                            fill: transparent;
                            ink: root.fg.with-alpha(0.8);
                            line: root.fg.with-alpha(0.25);
                            clicked => { root.timer-action("reset"); }
                        }

                        if root.timer.phase == 3: PillButton {
                            text: @tr("OK");
                            fill: root.accent;
                            ink: root.bg;
                            clicked => { root.timer-action("reset"); }
                        }
                    }

                    // Plugins WASM : une ligne de texte par plugin.
                    if !root.has-prompt && root.plugin-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for plugin in root.plugin-rows: Rectangle {
                            height: 22px;

                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 8px;

                                Text {
                                    text: plugin.name;
                                    color: root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    min-width: 64px;
                                }

                                Text {
                                    text: plugin.text;
                                    color: plugin.attention > 0 ? root.accent : root.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // Étagère : fichiers déposés sur l'île, un clic les ouvre.
                    if !root.has-prompt && root.shelf-rows.length > 0: HorizontalLayout {
                        height: 28px;
                        spacing: 6px;
                        padding-left: 6px;

                        Text {
                            text: @tr("Shelf");
                            color: root.fg.with-alpha(0.7);
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            min-width: 64px;
                        }

                        for item[i] in root.shelf-rows: Rectangle {
                            horizontal-stretch: 1;
                            height: 24px;
                            border-radius: 12px;
                            background: chip-ta.has-hover ? root.fg.with-alpha(0.2) : root.fg.with-alpha(0.12);

                            chip-ta := TouchArea {
                                clicked => { root.shelf-open(i); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 2px;
                                spacing: 2px;

                                Text {
                                    text: item.name;
                                    color: root.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 20px;
                                    Text {
                                        text: "×";
                                        color: root.fg.with-alpha(0.7);
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.shelf-remove(i); }
                                    }
                                }
                            }
                        }

                        if root.shelf-more != "": Text {
                            text: root.shelf-more;
                            color: root.fg.with-alpha(0.6);
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    // Agenda : prochaines réunions, bouton « Rejoindre ».
                    if !root.has-prompt && root.agenda-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for item in root.agenda-rows: Rectangle {
                            height: 24px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 2px;
                                spacing: 8px;

                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    background: item.soon ? root.accent : root.fg.with-alpha(0.35);
                                }

                                Text {
                                    text: item.time;
                                    color: item.soon ? root.accent : root.fg.with-alpha(0.7);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                if item.location != "": Text {
                                    text: item.location;
                                    color: root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: item.title;
                                    color: root.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if item.relative != "": Text {
                                    text: item.relative;
                                    color: item.soon ? root.accent : root.fg.with-alpha(0.55);
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                if item.has-join: Rectangle {
                                    width: join-label.preferred-width + 16px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 10px;
                                    background: join-ta.has-hover ? root.accent.brighter(0.15) : root.accent;

                                    join-label := Text {
                                        text: @tr("Join");
                                        color: root.bg;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    join-ta := TouchArea {
                                        clicked => { root.open-url(item.join-url); }
                                    }
                                }
                            }
                        }
                    }

                    // Sessions Claude Code en cours (clic : ramène le terminal).
                    if !root.has-prompt && root.claude-rows.length > 0: VerticalLayout {
                        spacing: 2px;

                        for row in root.claude-rows: Rectangle {
                            height: 24px;
                            border-radius: 6px;
                            background: row-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;

                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    background: row.urgent ? root.accent
                                        : row.active ? root.fg.with-alpha(0.7) : root.fg.with-alpha(0.25);
                                }

                                Text {
                                    text: row.project;
                                    color: root.fg;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: row.status;
                                    color: row.urgent ? root.accent : root.fg.with-alpha(0.6);
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            row-ta := TouchArea {
                                clicked => { root.claude-focus(row.id); }
                            }
                        }
                    }

                    if !root.has-prompt && !root.has-media && root.claude-rows.length == 0 && root.agenda-rows.length == 0: Text {
                        text: root.has-attention ? root.attention-label : @tr("All quiet");
                        color: root.has-attention && root.urgent ? root.accent : root.fg.with-alpha(0.75);
                        font-size: 14px;
                        overflow: elide;
                    }
                }

                // Onglet Claude : consommation estimée et conversations récentes.
                if root.tab == 1: VerticalLayout {
                    spacing: 3px;
                    alignment: start;
                    vertical-stretch: 1;

                    Text {
                        text: root.usage-text;
                        color: root.fg.with-alpha(0.8);
                        font-size: 12px;
                        overflow: elide;
                    }

                    if root.usage-has-limit: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: root.fg.with-alpha(0.15);

                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.usage-ratio, 0, 1);
                            border-radius: 2px;
                            background: root.usage-ratio > 0.85 ? #FF453A : root.accent;
                        }
                    }

                    for item in root.recent-rows: Rectangle {
                        height: 20px;
                        border-radius: 6px;
                        background: recent-ta.has-hover ? root.fg.with-alpha(0.12) : transparent;

                        recent-ta := TouchArea {
                            clicked => { root.recent-open(item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;

                            Text {
                                text: item.title;
                                color: root.fg;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: item.meta;
                                color: root.fg.with-alpha(0.5);
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    if root.recent-rows.length == 0: Text {
                        text: @tr("No conversation found");
                        color: root.fg.with-alpha(0.5);
                        font-size: 12px;
                    }
                }

                // Onglet des notifications : les dernières, un clic ouvre l'application.
                if root.tab == 2: VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    vertical-stretch: 1;

                    for item in root.notif-rows: Rectangle {
                        height: 26px;
                        border-radius: 8px;
                        background: notif-ta.has-hover || close-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;

                        notif-ta := TouchArea {
                            clicked => { root.notif-action("open:" + item.id); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 8px;

                            Avatar {
                                size: 18px;
                                y: (parent.height - self.height) / 2;
                                initial: item.initial;
                                tint: item.tint;
                            }

                            Text {
                                text: item.app;
                                color: item.tint;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            if item.title != "": Text {
                                text: item.title;
                                color: root.fg;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 140px;
                            }

                            Text {
                                text: item.body;
                                color: root.fg.with-alpha(0.6);
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: item.ago;
                                color: root.fg.with-alpha(0.45);
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 18px;
                                opacity: notif-ta.has-hover || close-ta.has-hover ? 1 : 0;

                                Text {
                                    text: "×";
                                    color: close-ta.has-hover ? root.accent : root.fg.with-alpha(0.7);
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                close-ta := TouchArea {
                                    clicked => { root.notif-action("remove:" + item.id); }
                                }
                            }
                        }
                    }

                    if root.notif-rows.length == 0: Text {
                        text: @tr("No notifications");
                        color: root.fg.with-alpha(0.5);
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
