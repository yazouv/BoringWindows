// L'île : une pilule en haut-centre de l'écran, dans une fenêtre transparente
// fixe dimensionnée pour l'état ouvert. Toute la logique (quand ouvrir, quoi
// afficher) vit côté Rust ; ce fichier ne fait que dessiner l'état reçu.
//
// Seules les transitions déclenchent un rendu : aucune animation en boucle,
// pour rester à ~0 % CPU au repos.

export struct ClaudeRow {
    id: string,
    project: string,
    status: string,
    urgent: bool,
    active: bool,
}

export struct ClaudePrompt {
    id: string,
    project: string,
    tool: string,
    detail: string,
}

export struct AgendaRow {
    title: string,
    time: string,
    location: string,
    relative: string,
    join-url: string,
    has-join: bool,
    soon: bool,
}

export struct MediaInfo {
    title: string,
    artist: string,
    source: string,
    playing: bool,
    can-previous: bool,
    can-next: bool,
    can-toggle: bool,
    can-seek: bool,
    has-art: bool,
    art: image,
    has-timeline: bool,
    position: string,
    duration: string,
    progress: float,
    multi-source: bool,
}

// Icônes dessinées (pas de police d'icônes à embarquer), viewbox 24x24.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <bool> enabled: true;
    in property <length> size: 30px;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.has-hover && root.enabled ? root.ink.with-alpha(0.12) : transparent;
    opacity: root.enabled ? 1 : 0.3;

    Path {
        width: root.size * 0.6;
        height: root.size * 0.6;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: root.icon == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon == "pause" ? "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"
            : root.icon == "next" ? "M 4 5 L 14 12 L 4 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : "M 20 5 L 10 12 L 20 19 Z M 6 5 L 9 5 L 9 19 L 6 19 Z";
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Dot inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <color> fill;
    in property <color> ink;
    in property <color> line: transparent;
    callback clicked;

    height: 28px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 1;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.line;
    background: ta.pressed ? root.fill.darker(0.2) : ta.has-hover ? root.fill.brighter(0.15) : root.fill;

    label := Text {
        text: root.text;
        color: root.ink;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Island inherits Window {
    title: "BoringWindows";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // --- Thème (depuis config.toml) ---
    in property <length> compact-width: 190px;
    in property <length> compact-height: 32px;
    in property <length> attention-width: 300px;
    in property <length> attention-height: 36px;
    in property <length> expanded-width: 520px;
    in property <length> expanded-height: 170px;
    in property <length> corner-radius: 22px;
    in property <length> top-offset: 0px;
    in property <duration> anim: 240ms;
    in property <color> bg: black;
    in property <color> fg: white;
    in property <color> accent: #ff8a3d;

    // --- État ---
    in property <bool> expanded;
    in property <bool> has-attention;
    in property <bool> urgent;
    in property <string> attention-label;
    in property <string> time-text: "--:--";
    in property <string> date-text;
    in property <[ClaudeRow]> claude-rows;
    in property <bool> has-prompt;
    in property <ClaudePrompt> prompt;
    in property <bool> has-media;
    in property <MediaInfo> media;
    in property <[AgendaRow]> agenda-rows;
    in property <bool> compact-art-visible;
    in property <image> compact-art;

    callback hover-changed(bool);
    callback clicked();
    callback claude-decide(string /* id */, string /* allow | deny | ask */);
    callback claude-focus(string /* session */);
    callback media-action(string /* toggle | next | prev | source */);
    callback media-seek(float /* 0..1 */);
    callback open-url(string);

    // Taille fixe de la fenêtre : la pilule grandit dedans, la zone cliquable
    // est restreinte à la pilule côté Win32.
    width: root.expanded-width;
    height: root.expanded-height + root.top-offset;

    pill := Rectangle {
        property <length> radius: root.expanded ? root.corner-radius : self.height / 2;
        // Collée en haut de l'écran : coins supérieurs carrés, façon encoche.
        property <length> top-radius: root.top-offset > 0 ? self.radius : 0;

        y: root.top-offset;
        x: (root.width - self.width) / 2;
        width: root.expanded ? root.expanded-width
            : root.has-attention ? root.attention-width : root.compact-width;
        height: root.expanded ? root.expanded-height
            : root.has-attention ? root.attention-height : root.compact-height;
        background: root.bg;
        clip: true;
        border-top-left-radius: self.top-radius;
        border-top-right-radius: self.top-radius;
        border-bottom-left-radius: self.radius;
        border-bottom-right-radius: self.radius;

        animate width, height, radius { duration: root.anim; easing: ease-out-quint; }

        // Le contenu est dans la zone de survol : les boutons reçoivent leurs
        // clics sans faire perdre le survol à l'île.
        TouchArea {
            changed has-hover => {
                root.hover-changed(self.has-hover);
            }
            clicked => {
                root.clicked();
            }

            // Contenu compact : le module qui réclame l'attention.
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                opacity: root.has-attention && !root.expanded ? 1 : 0;
                animate opacity { duration: root.anim / 2; }

                if !root.compact-art-visible: Dot {
                    y: (parent.height - self.height) / 2;
                    background: root.urgent ? root.accent : root.fg.with-alpha(0.6);
                }

                if root.compact-art-visible: Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.compact-art;
                        image-fit: cover;
                    }
                }

                Text {
                    text: root.attention-label;
                    color: root.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Contenu ouvert.
            VerticalLayout {
                padding: 16px;
                padding-top: 10px + root.top-offset / 2;
                spacing: 8px;
                opacity: root.expanded ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: root.anim; }

                HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: root.time-text;
                        color: root.fg;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.date-text;
                        color: root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Source de la musique ; cliquable s'il y en a plusieurs.
                    if root.has-media: Text {
                        text: root.media.multi-source ? root.media.source + "  ⇄" : root.media.source;
                        color: source-ta.has-hover && root.media.multi-source ? root.fg : root.fg.with-alpha(0.55);
                        font-size: 12px;
                        vertical-alignment: center;

                        source-ta := TouchArea {
                            enabled: root.media.multi-source;
                            clicked => { root.media-action("source"); }
                        }
                    }
                }

                // Lecteur (masqué pendant une demande de permission, prioritaire).
                if root.has-media && !root.has-prompt: HorizontalLayout {
                    height: 56px;
                    spacing: 12px;

                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 8px;
                        clip: true;
                        background: root.fg.with-alpha(0.08);

                        if root.media.has-art: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.media.art;
                            image-fit: cover;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.media.title;
                            color: root.fg;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.media.artist;
                            color: root.fg.with-alpha(0.6);
                            font-size: 12px;
                            overflow: elide;
                        }

                        if root.media.has-timeline: HorizontalLayout {
                            spacing: 6px;
                            padding-top: 4px;

                            Text {
                                text: root.media.position;
                                color: root.fg.with-alpha(0.5);
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            bar := Rectangle {
                                height: 12px;
                                horizontal-stretch: 1;

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: bar-ta.has-hover && root.media.can-seek ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: root.fg.with-alpha(0.15);
                                }

                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width * clamp(root.media.progress, 0, 1);
                                    height: bar-ta.has-hover && root.media.can-seek ? 5px : 3px;
                                    border-radius: self.height / 2;
                                    background: root.accent;
                                }

                                bar-ta := TouchArea {
                                    enabled: root.media.can-seek;
                                    clicked => { root.media-seek(self.mouse-x / self.width); }
                                }
                            }

                            Text {
                                text: root.media.duration;
                                color: root.fg.with-alpha(0.5);
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: center;
                        horizontal-stretch: 0;

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "previous";
                            ink: root.fg;
                            enabled: root.media.can-previous;
                            clicked => { root.media-action("prev"); }
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            size: 36px;
                            icon: root.media.playing ? "pause" : "play";
                            ink: root.fg;
                            enabled: root.media.can-toggle;
                            clicked => { root.media-action("toggle"); }
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "next";
                            ink: root.fg;
                            enabled: root.media.can-next;
                            clicked => { root.media-action("next"); }
                        }
                    }
                }

                // Demande de permission de Claude Code.
                if root.has-prompt: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: root.prompt.project + " veut utiliser " + root.prompt.tool;
                        color: root.accent;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.prompt.detail;
                        color: root.fg.with-alpha(0.75);
                        font-size: 12px;
                        font-family: "Consolas";
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        PillButton {
                            text: "Autoriser";
                            fill: root.accent;
                            ink: root.bg;
                            clicked => { root.claude-decide(root.prompt.id, "allow"); }
                        }

                        PillButton {
                            text: "Refuser";
                            fill: root.fg.with-alpha(0.12);
                            ink: root.fg;
                            clicked => { root.claude-decide(root.prompt.id, "deny"); }
                        }

                        PillButton {
                            text: "Terminal";
                            fill: transparent;
                            ink: root.fg.with-alpha(0.8);
                            line: root.fg.with-alpha(0.25);
                            clicked => { root.claude-decide(root.prompt.id, "ask"); }
                        }
                    }
                }

                // Agenda : prochaines réunions, bouton « Rejoindre ».
                if !root.has-prompt && root.agenda-rows.length > 0: VerticalLayout {
                    spacing: 2px;

                    for item in root.agenda-rows: Rectangle {
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 2px;
                            spacing: 8px;

                            Dot {
                                y: (parent.height - self.height) / 2;
                                background: item.soon ? root.accent : root.fg.with-alpha(0.35);
                            }

                            Text {
                                text: item.time;
                                color: item.soon ? root.accent : root.fg.with-alpha(0.7);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            if item.location != "": Text {
                                text: item.location;
                                color: root.fg.with-alpha(0.55);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.title;
                                color: root.fg;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            if item.relative != "": Text {
                                text: item.relative;
                                color: item.soon ? root.accent : root.fg.with-alpha(0.55);
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            if item.has-join: Rectangle {
                                width: join-label.preferred-width + 16px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: join-ta.has-hover ? root.accent.brighter(0.15) : root.accent;

                                join-label := Text {
                                    text: "Rejoindre";
                                    color: root.bg;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                join-ta := TouchArea {
                                    clicked => { root.open-url(item.join-url); }
                                }
                            }
                        }
                    }
                }

                // Sessions Claude Code en cours (clic : ramène le terminal).
                if !root.has-prompt && root.claude-rows.length > 0: VerticalLayout {
                    spacing: 2px;

                    for row in root.claude-rows: Rectangle {
                        height: 24px;
                        border-radius: 6px;
                        background: row-ta.has-hover ? root.fg.with-alpha(0.08) : transparent;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;

                            Dot {
                                y: (parent.height - self.height) / 2;
                                background: row.urgent ? root.accent
                                    : row.active ? root.fg.with-alpha(0.7) : root.fg.with-alpha(0.25);
                            }

                            Text {
                                text: row.project;
                                color: root.fg;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: row.status;
                                color: row.urgent ? root.accent : root.fg.with-alpha(0.6);
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }

                        row-ta := TouchArea {
                            clicked => { root.claude-focus(row.id); }
                        }
                    }
                }

                if !root.has-prompt && !root.has-media && root.claude-rows.length == 0 && root.agenda-rows.length == 0: Text {
                    text: root.has-attention ? root.attention-label : "Rien à signaler";
                    color: root.has-attention && root.urgent ? root.accent : root.fg.with-alpha(0.75);
                    font-size: 14px;
                    overflow: elide;
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
