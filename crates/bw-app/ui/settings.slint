// Fenêtre de réglages : édite config.toml sans avoir à l'ouvrir.
// Créée à l'ouverture, détruite à la fermeture. Chaque modification appelle
// `changed(clé)` ; Rust lit la propriété correspondante et l'enregistre.

import { Button, CheckBox, ComboBox, GroupBox, LineEdit, ScrollView, SpinBox, TabWidget, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct CalendarSourceRow {
    name: string,
    url: string,
}

export struct PlayerRow {
    token: string,
    name: string,
    ignored: bool,
}

component Hint inherits Text {
    font-size: 12px;
    opacity: 0.7;
    wrap: word-wrap;
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;

    Text {
        text: root.label;
        min-width: 220px;
        vertical-alignment: center;
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    callback picked;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: root.swatch;
    border-width: ta.has-hover ? 2px : 0px;
    border-color: white;

    ta := TouchArea {
        clicked => { root.picked(); }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("BoringWindows · Settings");
    preferred-width: 760px;
    preferred-height: 580px;
    min-width: 640px;
    min-height: 480px;

    // --- Général ---
    in-out property <int> language-index;
    in-out property <bool> auto-update;
    in property <string> app-version;
    in property <bool> update-checking;
    in property <bool> update-ready;
    in-out property <int> open-on-index;
    in-out property <int> monitor-index;
    in-out property <bool> hide-fullscreen;
    in-out property <bool> autostart;
    // --- Apparence ---
    in property <[string]> themes;
    in-out property <int> theme-index;
    in-out property <string> accent;
    in property <color> accent-preview;
    in-out property <string> background-color;
    in-out property <int> animation-ms;
    in-out property <int> corner-radius;
    in-out property <int> compact-w;
    in-out property <int> compact-h;
    in-out property <int> expanded-w;
    in-out property <int> expanded-h;
    in property <[string]> module-order;
    callback module-moved(int, int);
    // --- Agenda ---
    in property <[CalendarSourceRow]> sources;
    in-out property <int> remind-minutes;
    in-out property <int> lookahead-hours;
    in-out property <int> refresh-minutes;
    in-out property <bool> show-all-day;
    in-out property <int> provider-index;
    in property <[string]> providers;
    in property <string> provider-help;
    in property <bool> provider-is-file;
    in-out property <string> new-name;
    in-out property <string> new-url;
    in property <string> test-status;
    in property <bool> test-ok;
    in property <bool> testing;
    // --- Claude ---
    in property <bool> hooks-installed;
    in-out property <bool> claude-permissions;
    in-out property <bool> claude-sound;
    in-out property <int> claude-wait;
    in property <string> doctor-report;
    in property <bool> doctor-running;
    // --- Musique ---
    in-out property <bool> media-accent;
    in-out property <string> media-ignore;
    // --- Pied de page ---
    in property <string> status;
    in property <bool> status-error;

    in property <[PlayerRow]> players;
    callback player-toggled(string, bool);
    callback changed(string);
    callback theme-picked(int);
    callback update-clicked();
    callback open-themes-folder();
    callback provider-changed(int);
    callback open-guide();
    callback browse-file();
    callback test-source();
    callback add-source();
    callback remove-source(int);
    callback toggle-hooks();
    callback run-doctor();
    callback open-config-file();
    callback open-docs();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        TabWidget {
            Tab {
                title: @tr("General");
                VerticalBox {
                    alignment: start;

                    Row {
                        label: @tr("Language");
                        ComboBox {
                            // Noms des langues dans leur propre langue : non traduits.
                            model: [@tr("Automatic (Windows)"), "English", "Français"];
                            current-index <=> root.language-index;
                            selected => { root.changed("general.language"); }
                        }
                    }

                    Row {
                        label: @tr("Open the island");
                        ComboBox {
                            model: [@tr("on hover"), @tr("on click")];
                            current-index <=> root.open-on-index;
                            selected => { root.changed("general.open_on"); }
                        }
                    }

                    Row {
                        label: @tr("Screen");
                        ComboBox {
                            model: [@tr("main screen"), @tr("screen under the mouse (at startup)")];
                            current-index <=> root.monitor-index;
                            selected => { root.changed("general.monitor"); }
                        }
                    }

                    CheckBox {
                        text: @tr("Hide the island when an app is full screen");
                        checked <=> root.hide-fullscreen;
                        toggled => { root.changed("general.hide_in_fullscreen"); }
                    }

                    CheckBox {
                        text: @tr("Start BoringWindows with Windows");
                        checked <=> root.autostart;
                        toggled => { root.changed("autostart"); }
                    }

                    CheckBox {
                        text: @tr("Install updates automatically");
                        checked <=> root.auto-update;
                        toggled => { root.changed("general.auto_update"); }
                    }

                    Row {
                        label: @tr("Version {}", root.app-version);
                        Button {
                            text: root.update-ready ? @tr("Restart to update")
                                : root.update-checking ? @tr("Checking…") : @tr("Check for updates");
                            enabled: !root.update-checking;
                            primary: root.update-ready;
                            clicked => { root.update-clicked(); }
                        }
                    }
                }
            }

            Tab {
                title: @tr("Appearance");
                VerticalBox {
                    alignment: start;

                    Row {
                        label: @tr("Theme");
                        ComboBox {
                            model: root.themes;
                            current-index <=> root.theme-index;
                            selected => { root.theme-picked(self.current-index); }
                        }
                        Button {
                            text: @tr("Themes folder");
                            clicked => { root.open-themes-folder(); }
                        }
                    }

                    Row {
                        label: @tr("Accent color");
                        LineEdit {
                            text <=> root.accent;
                            placeholder-text: "#FF8A3D";
                            edited => { root.changed("theme.accent"); }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: root.accent-preview;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 232px;
                        for c[i] in [#FF8A3D, #FF453A, #FFD60A, #30D158, #5AC8FA, #0A84FF, #BF5AF2, #FF375F]: Swatch {
                            swatch: c;
                            picked => {
                                root.accent = ["#FF8A3D", "#FF453A", "#FFD60A", "#30D158", "#5AC8FA", "#0A84FF", "#BF5AF2", "#FF375F"][i];
                                root.changed("theme.accent");
                            }
                        }
                    }

                    Row {
                        label: @tr("Background color");
                        LineEdit {
                            text <=> root.background-color;
                            placeholder-text: "#000000";
                            edited => { root.changed("theme.background"); }
                        }
                    }

                    Row {
                        label: @tr("Animation duration (ms)");
                        SpinBox {
                            minimum: 0;
                            maximum: 2000;
                            step-size: 20;
                            value <=> root.animation-ms;
                            edited => { root.changed("theme.animation_ms"); }
                        }
                    }

                    Row {
                        label: @tr("Corner radius of the open island");
                        SpinBox {
                            minimum: 0;
                            maximum: 100;
                            value <=> root.corner-radius;
                            edited => { root.changed("theme.corner_radius"); }
                        }
                    }

                    Row {
                        label: @tr("Compact island size (px)");
                        SpinBox {
                            minimum: 16;
                            maximum: 4000;
                            value <=> root.compact-w;
                            edited => { root.changed("theme.compact"); }
                        }
                        SpinBox {
                            minimum: 8;
                            maximum: 2000;
                            value <=> root.compact-h;
                            edited => { root.changed("theme.compact"); }
                        }
                    }

                    Row {
                        label: @tr("Open island size (px)");
                        SpinBox {
                            minimum: 16;
                            maximum: 4000;
                            value <=> root.expanded-w;
                            edited => { root.changed("theme.expanded"); }
                        }
                        SpinBox {
                            minimum: 8;
                            maximum: 2000;
                            value <=> root.expanded-h;
                            edited => { root.changed("theme.expanded"); }
                        }
                    }

                    Text {
                        text: @tr("Priority in the compact island (first wins)");
                    }
                    for name[i] in root.module-order: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: name;
                            min-width: 220px;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "↑";
                            enabled: i > 0;
                            clicked => { root.module-moved(i, -1); }
                        }
                        Button {
                            text: "↓";
                            enabled: i < root.module-order.length - 1;
                            clicked => { root.module-moved(i, 1); }
                        }
                    }

                    Hint {
                        text: @tr("Changes apply to the island right away. Picking a theme replaces the colors above with the theme's; your own themes go in the themes folder (one .toml file each, see the documentation). The accent color is replaced by the album art color while music plays (Music tab).");
                    }
                }
            }

            Tab {
                title: @tr("Calendar");
                ScrollView {
                    VerticalBox {
                        alignment: start;

                        GroupBox {
                            title: @tr("My calendars");
                            VerticalLayout {
                                spacing: 6px;

                                if root.sources.length == 0: Hint {
                                    text: @tr("No calendar yet: add one below.");
                                }

                                for source[i] in root.sources: HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: source.name != "" ? source.name : @tr("(no name)");
                                        font-weight: 600;
                                        min-width: 120px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: source.url;
                                        opacity: 0.7;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: @tr("Remove");
                                        clicked => { root.remove-source(i); }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: @tr("Add a calendar");
                            VerticalLayout {
                                spacing: 8px;

                                Row {
                                    label: @tr("Service");
                                    ComboBox {
                                        model: root.providers;
                                        current-index <=> root.provider-index;
                                        selected => { root.provider-changed(self.current-index); }
                                    }
                                    Button {
                                        text: @tr("Step-by-step guide");
                                        clicked => { root.open-guide(); }
                                    }
                                }

                                Hint {
                                    text: root.provider-help;
                                }

                                Row {
                                    label: @tr("Name (optional)");
                                    LineEdit {
                                        text <=> root.new-name;
                                        placeholder-text: @tr("Work, School, Personal…");
                                    }
                                }

                                Row {
                                    label: root.provider-is-file ? @tr(".ics file") : @tr("ICS link");
                                    LineEdit {
                                        text <=> root.new-url;
                                        placeholder-text: root.provider-is-file ? "C:/Users/…/agenda.ics" : @tr("https://…  or  webcal://…");
                                    }
                                    if root.provider-is-file: Button {
                                        text: @tr("Browse…");
                                        clicked => { root.browse-file(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;

                                    Text {
                                        text: root.test-status;
                                        color: root.test-ok ? #30D158 : #FF453A;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }

                                    Button {
                                        text: root.testing ? @tr("Testing…") : @tr("Test");
                                        enabled: !root.testing && root.new-url != "";
                                        clicked => { root.test-source(); }
                                    }

                                    Button {
                                        text: @tr("Add");
                                        primary: true;
                                        enabled: root.new-url != "";
                                        clicked => { root.add-source(); }
                                    }
                                }
                            }
                        }

                        GroupBox {
                            title: @tr("Display");
                            VerticalLayout {
                                spacing: 6px;

                                Row {
                                    label: @tr("Reminder before start (min)");
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 120;
                                        value <=> root.remind-minutes;
                                        edited => { root.changed("modules.calendar.remind_minutes"); }
                                    }
                                }

                                Row {
                                    label: @tr("Time span shown (hours)");
                                    SpinBox {
                                        minimum: 1;
                                        maximum: 168;
                                        value <=> root.lookahead-hours;
                                        edited => { root.changed("modules.calendar.lookahead_hours"); }
                                    }
                                }

                                Row {
                                    label: @tr("Refresh every (min)");
                                    SpinBox {
                                        minimum: 2;
                                        maximum: 1440;
                                        value <=> root.refresh-minutes;
                                        edited => { root.changed("modules.calendar.refresh_minutes"); }
                                    }
                                }

                                CheckBox {
                                    text: @tr("Show all-day events");
                                    checked <=> root.show-all-day;
                                    toggled => { root.changed("modules.calendar.show_all_day"); }
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Claude Code";
                VerticalBox {
                    Row {
                        label: root.hooks-installed ? @tr("Hooks installed ✓") : @tr("Hooks not installed");
                        Button {
                            text: root.hooks-installed ? @tr("Remove hooks") : @tr("Install hooks");
                            primary: !root.hooks-installed;
                            clicked => { root.toggle-hooks(); }
                        }
                    }

                    Hint {
                        text: @tr("After installing, restart your Claude Code sessions: they only read their hooks at startup.");
                    }

                    CheckBox {
                        text: @tr("Answer permission requests from the island");
                        checked <=> root.claude-permissions;
                        toggled => { root.changed("modules.claude.permissions"); }
                    }

                    CheckBox {
                        text: @tr("Sound when Claude is waiting for you (question, plan, permission)");
                        checked <=> root.claude-sound;
                        toggled => { root.changed("modules.claude.sound"); }
                    }

                    Row {
                        label: @tr("Time to answer in the island (s)");
                        SpinBox {
                            minimum: 5;
                            maximum: 280;
                            value <=> root.claude-wait;
                            edited => { root.changed("modules.claude.permission_wait_secs"); }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: root.doctor-running ? @tr("Running diagnostic…") : @tr("Run diagnostic");
                            enabled: !root.doctor-running;
                            clicked => { root.run-doctor(); }
                        }
                    }

                    if root.doctor-report != "": TextEdit {
                        text: root.doctor-report;
                        read-only: true;
                        font-size: 11px;
                        vertical-stretch: 1;
                    }
                    // Sans rapport, l'espace libre reste en bas.
                    if root.doctor-report == "": Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }

            Tab {
                title: @tr("Music");
                VerticalBox {
                    alignment: start;

                    CheckBox {
                        text: @tr("Tint the island with the album art color");
                        checked <=> root.media-accent;
                        toggled => { root.changed("modules.media.accent_from_artwork"); }
                    }

                    if root.players.length > 0: Text {
                        text: @tr("Players seen recently (tick to ignore)");
                    }
                    for player in root.players: CheckBox {
                        text: player.name;
                        checked: player.ignored;
                        toggled => { root.player-toggled(player.token, self.checked); }
                    }

                    Row {
                        label: @tr("Players to ignore");
                        LineEdit {
                            text <=> root.media-ignore;
                            placeholder-text: "msedge, chrome";
                            edited => { root.changed("modules.media.ignore"); }
                        }
                    }

                    Hint {
                        text: @tr("Separate names with commas; part of the name is enough. Spotify, Apple Music, browsers, VLC… are detected automatically.");
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.status;
                color: root.status-error ? #FF453A : #30D158;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Button {
                text: @tr("Documentation");
                clicked => { root.open-docs(); }
            }

            Button {
                text: @tr("Open config.toml");
                clicked => { root.open-config-file(); }
            }
        }
    }
}
