// Fenêtre de réglages : édite config.toml sans avoir à l'ouvrir.
// Créée à l'ouverture, détruite à la fermeture. Chaque modification appelle
// `changed(clé)` ; Rust lit la propriété correspondante et l'enregistre.
//
// Mise en page à la manière des Réglages de Windows 11 : navigation à gauche,
// une page par sujet, chaque réglage dans une tuile (titre et explication à
// gauche, contrôle à droite). Les options qui dépendent d'un interrupteur sont
// rangées sous lui, dans la même tuile.

import { Button, ComboBox, LineEdit, Palette, ScrollView, SpinBox, Switch, TextEdit } from "std-widgets.slint";

export struct CalendarSourceRow {
    name: string,
    url: string,
}

export struct PlayerRow {
    token: string,
    name: string,
    ignored: bool,
}

// Couleurs de la fenêtre, d'après le thème clair ou sombre de Windows.
global Ui {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> window: dark ? #202020 : #f3f3f3;
    out property <brush> card: dark ? #2b2b2b : #fbfbfb;
    out property <brush> card-border: dark ? #1d1d1d : #e5e5e5;
    out property <brush> divider: dark ? #1d1d1d : #ebebeb;
    out property <brush> text: Palette.foreground;
    out property <brush> muted: dark ? #c8c8c8 : #5f5f5f;
    out property <brush> hover: dark ? #ffffff0d : #00000008;
    out property <brush> selected: dark ? #ffffff12 : #0000000c;
    out property <brush> accent: Palette.accent-background;
    out property <brush> ok: dark ? #6ccb5f : #0f7b0f;
    out property <brush> error: dark ? #ff99a4 : #c42b1c;
}

// Pictogrammes au trait, viewbox 24x24 (tracés d'après Lucide, licence ISC).
component Icon inherits Path {
    in property <string> name;
    in property <brush> ink: Ui.text;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.ink;
    stroke-width: 1.6px;
    fill: transparent;
    commands: root.name == "general" ? "M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4"
        : root.name == "appearance" ? "M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z M14 6.5a.5 .5 0 1 1-1 0a.5 .5 0 1 1 1 0 M18 10.5a.5 .5 0 1 1-1 0a.5 .5 0 1 1 1 0 M7 12.5a.5 .5 0 1 1-1 0a.5 .5 0 1 1 1 0 M9 7.5a.5 .5 0 1 1-1 0a.5 .5 0 1 1 1 0"
        : root.name == "notifications" ? "M10.268 21a2 2 0 0 0 3.464 0 M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"
        : root.name == "claude" ? "M4 17l6-6-6-6 M12 19h8"
        : root.name == "calendar" ? "M8 2v4 M16 2v4 M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M3 10h18"
        : root.name == "music" ? "M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0a3 3 0 1 1 6 0 M21 16a3 3 0 1 1-6 0a3 3 0 1 1 6 0"
        : root.name == "weather" ? "M12 2v2 M4.93 4.93l1.41 1.41 M20 12h2 M19.07 4.93l-1.41 1.41 M15.947 12.65a4 4 0 0 0-5.925-4.128 M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"
        : root.name == "timer" ? "M10 2h4 M12 14l3-3 M20 14a8 8 0 1 1-16 0a8 8 0 1 1 16 0"
        : root.name == "shelf" ? "M2 12h6l2 3h4l2-3h6 M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"
        : root.name == "mascot" ? "M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0 M8 14s1.5 2 4 2 4-2 4-2 M9 9h.01 M15 9h.01"
        : root.name == "system" ? "M12 20v2 M12 2v2 M17 20v2 M17 2v2 M2 12h2 M2 17h2 M2 7h2 M20 12h2 M20 17h2 M20 7h2 M7 20v2 M7 2v2 M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M9 8h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"
        : root.name == "docs" ? "M12 7v14 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
        : root.name == "file" ? "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4 M16 13H8 M16 17H8 M10 9H8"
        : root.name == "check" ? "M20 6L9 17l-5-5"
        : root.name == "alert" ? "M12 8v4 M12 16h.01 M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0"
        : "";
}

// Entrée de la barre latérale.
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: 5px;
    background: root.selected ? Ui.selected : ta.has-hover ? Ui.hover : transparent;

    // Trait d'accent devant l'entrée choisie.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Ui.accent;
        animate height { duration: 150ms; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon { name: root.icon; }
        }

        Text {
            text: root.label;
            color: Ui.text;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Titre d'un groupe de tuiles.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;

    if root.title != "": Text {
        text: root.title;
        color: Ui.text;
        font-size: 14px;
        font-weight: 600;
        // Espace entre le titre et sa première tuile.
        height: self.preferred-height + 6px;
        vertical-alignment: top;
    }
}

// Fond d'une tuile ; contient une ou plusieurs lignes `Setting`.
component Card inherits Rectangle {
    background: Ui.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Ui.card-border;

    VerticalLayout {
        @children
    }
}

// Ligne de réglage : titre et explication à gauche, contrôles à droite.
// `nested` la range sous la ligne précédente (retrait et filet au-dessus),
// `divided` ajoute seulement le filet.
component Setting inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> nested;
    in property <bool> divided: root.nested;
    in property <brush> title-color: Ui.text;
    min-height: 62px;

    if root.divided: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Ui.divider;
    }

    HorizontalLayout {
        padding-left: root.nested ? 52px : 16px;
        padding-right: 16px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 24px;

        VerticalLayout {
            alignment: center;
            spacing: root.description == "" ? 0px : 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: root.title-color;
                font-size: 14px;
                wrap: word-wrap;
                height: self.preferred-height;
                opacity: root.enabled ? 1 : 0.45;
            }

            // Toujours présent (pas de `if`) : la hauteur suit la largeur réelle.
            Text {
                text: root.description;
                color: Ui.muted;
                font-size: 12px;
                wrap: word-wrap;
                opacity: root.enabled ? 1 : 0.45;
                height: root.description == "" ? 0px : self.preferred-height;
            }
        }

        controls := VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                @children
            }
        }
    }
}

// Interrupteur sans texte, aligné à droite d'une ligne `Setting`.
component Toggle inherits Switch {
    text: "";
}

// Petit texte d'explication sous une tuile.
component Hint inherits Text {
    color: Ui.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// Page : titre fixe, contenu qui défile.
component Page inherits VerticalLayout {
    in property <string> title;
    // Titre aligné sur le contenu (marge de 32 px, comme les tuiles).
    padding-left: 0px;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;

      Text {
        text: root.title;
        color: Ui.text;
        font-size: 28px;
        font-weight: 600;
        height: self.preferred-height + 28px;
        vertical-alignment: bottom;
      }
    }

    Rectangle { height: 14px; }

    sv := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: sv.visible-width;
            padding-left: 32px;
            padding-right: 32px;
            padding-bottom: 32px;
            spacing: 24px;
            alignment: start;
            @children
        }
    }
}

// Pastille de couleur proposée pour l'accent.
component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> current;
    callback picked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: root.current ? 2px : ta.has-hover ? 2px : 0px;
    border-color: root.current ? Ui.text : Ui.muted;

    Rectangle {
        width: root.current || ta.has-hover ? 18px : 26px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.swatch;
        animate width { duration: 100ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// Badge d'état (vert : bon, orange : à faire).
component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> good;
    border-radius: 10px;
    height: 22px;
    background: root.good ? (Ui.dark ? #6ccb5f26 : #0f7b0f1a) : (Ui.dark ? #fce10026 : #9d5d001a);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Icon {
                name: root.good ? "check" : "alert";
                ink: root.good ? Ui.ok : (Ui.dark ? #fce100 : #9d5d00);
                width: 12px;
                height: 12px;
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            color: root.good ? Ui.ok : (Ui.dark ? #fce100 : #9d5d00);
            vertical-alignment: center;
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("BoringWindows · Settings");
    preferred-width: 980px;
    preferred-height: 700px;
    min-width: 780px;
    min-height: 520px;
    background: Ui.window;

    // Page affichée (ordre de la barre latérale).
    in-out property <int> page;

    // --- Général ---
    in-out property <int> language-index;
    in-out property <bool> auto-update;
    in property <string> app-version;
    in property <bool> update-checking;
    in property <bool> update-ready;
    in-out property <int> open-on-index;
    in-out property <int> monitor-index;
    in-out property <bool> hide-fullscreen;
    in-out property <bool> autostart;
    in-out property <bool> volume-enabled;
    in-out property <bool> brightness-enabled;
    in-out property <bool> battery-enabled;
    in-out property <bool> bluetooth-enabled;
    in-out property <bool> gestures-enabled;
    in-out property <bool> presentation-enabled;
    in-out property <bool> hide-from-capture;
    in-out property <bool> hide-only-when-live;
    // --- Mascotte ---
    in-out property <bool> mascot-enabled;
    in-out property <bool> mascot-always-animated;
    in-out property <bool> mascot-music;
    in-out property <bool> mascot-seasonal;
    // Accessoire (index dans la liste) et couleur (« #RRGGBB », vide : thème).
    in-out property <int> mascot-accessory-index;
    in-out property <string> mascot-color;
    in-out property <bool> notifications-enabled;
    in-out property <bool> notifications-content;
    in-out property <bool> notifications-original;
    in-out property <bool> viz-enabled;
    in-out property <bool> activity-enabled;
    in-out property <int> activity-limit-millions;
    in-out property <string> activity-reset;
    in-out property <bool> plugins-enabled;
    callback open-plugins-folder();
    // --- Apparence ---
    in property <[string]> themes;
    in-out property <int> theme-index;
    in-out property <bool> blur;
    in-out property <bool> glow;
    in-out property <bool> system-accent;
    // --- Météo ---
    in-out property <bool> weather-enabled;
    in-out property <string> weather-city;
    in-out property <int> weather-units-index;
    in-out property <string> accent;
    in property <color> accent-preview;
    in-out property <string> background-color;
    in-out property <int> animation-ms;
    in-out property <int> corner-radius;
    in-out property <int> compact-w;
    in-out property <int> compact-h;
    in-out property <int> expanded-w;
    in-out property <int> expanded-h;
    in property <[string]> module-order;
    callback module-moved(int, int);
    // --- Agenda ---
    in property <[CalendarSourceRow]> sources;
    in-out property <int> remind-minutes;
    in-out property <int> lookahead-hours;
    in-out property <int> refresh-minutes;
    in-out property <bool> show-all-day;
    in-out property <int> provider-index;
    in property <[string]> providers;
    in property <string> provider-help;
    in property <bool> provider-is-file;
    in property <bool> provider-is-caldav;
    in-out property <string> new-username;
    in-out property <string> new-password;
    in-out property <string> new-name;
    in-out property <string> new-url;
    in property <string> test-status;
    in property <bool> test-ok;
    in property <bool> testing;
    // --- Claude ---
    in property <bool> hooks-installed;
    in-out property <bool> claude-permissions;
    in-out property <bool> claude-sound;
    in-out property <int> claude-wait;
    in property <string> doctor-report;
    in property <bool> doctor-running;
    // --- Musique ---
    in-out property <bool> media-accent;
    in-out property <string> media-ignore;
    in-out property <bool> shelf-enabled;
    in-out property <int> shelf-max;
    callback shelf-clear();
    in-out property <bool> timer-enabled;
    in-out property <bool> timer-sound;
    in-out property <string> timer-presets;
    // --- Système ---
    in-out property <bool> system-enabled;
    in-out property <int> system-refresh;
    in-out property <int> cpu-alert-index;
    in-out property <int> ram-alert-index;
    in-out property <bool> network-enabled;
    in-out property <int> network-compact-index;
    in-out property <int> network-unit-index;
    in-out property <bool> network-announce-connection;
    in-out property <bool> network-announce-vpn;
    in-out property <bool> network-announce-wifi;
    in-out property <bool> transfers-enabled;
    in-out property <bool> transfers-copies;
    in-out property <bool> transfers-downloads;
    in-out property <bool> transfers-announce;
    in-out property <bool> ask-enabled;
    // Modèles proposés (un identifiant écrit à la main vient en premier).
    in property <[string]> ask-models;
    in-out property <int> ask-model-index;
    in-out property <string> ask-claude-key;
    in property <bool> ask-claude-saved;
    in-out property <string> ask-gemini-key;
    in property <bool> ask-gemini-saved;
    in-out property <string> hotkey-ask;
    in-out property <bool> github-enabled;
    in-out property <bool> github-use-gh;
    in-out property <string> github-token;
    in property <bool> github-token-saved;
    in-out property <int> github-refresh-index;
    in-out property <bool> github-announce-ci;
    in-out property <bool> github-announce-reviews;
    in-out property <string> hotkey-toggle;
    in-out property <string> hotkey-play-pause;
    in-out property <string> hotkey-next;
    in-out property <string> hotkey-previous;
    in-out property <string> hotkey-dnd;
    in-out property <string> hotkey-quick-add;
    in-out property <bool> tasks-enabled;
    // --- État de l'enregistrement ---
    in property <string> status;
    in property <bool> status-error;

    in property <[PlayerRow]> players;
    callback player-toggled(string, bool);
    callback changed(string);
    callback theme-picked(int);
    callback update-clicked();
    callback open-themes-folder();
    callback open-layouts-folder();
    in-out property <string> view-name;
    callback provider-changed(int);
    callback open-guide();
    callback browse-file();
    callback test-source();
    callback add-source();
    callback remove-source(int);
    callback toggle-hooks();
    callback run-doctor();
    callback open-config-file();
    callback open-docs();
    callback open-welcome();

    property <bool> source-ready: root.new-url != "" && (!root.provider-is-caldav || (root.new-username != "" && root.new-password != ""));

    HorizontalLayout {
        // --- Barre latérale ---
        VerticalLayout {
            width: 248px;
            padding: 12px;
            padding-top: 16px;
            spacing: 2px;

            // L'île en miniature, en guise de logo.
            HorizontalLayout {
                padding-left: 14px;
                padding-bottom: 18px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 30px;
                        height: 12px;
                        border-radius: 6px;
                        background: #000000;
                        border-width: Ui.dark ? 1px : 0px;
                        border-color: #ffffff26;

                        Rectangle {
                            x: parent.width - 10px;
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Ui.accent;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "BoringWindows";
                        color: Ui.text;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    Text {
                        text: @tr("Version {}", root.app-version);
                        color: Ui.muted;
                        font-size: 11px;
                    }
                }
            }

            for item[i] in [
                { icon: "general", label: @tr("General") },
                { icon: "appearance", label: @tr("Appearance") },
                { icon: "notifications", label: @tr("Notifications") },
                { icon: "claude", label: "Claude Code" },
                { icon: "calendar", label: @tr("Calendar") },
                { icon: "music", label: @tr("Music") },
                { icon: "weather", label: @tr("Weather") },
                { icon: "timer", label: @tr("Timer") },
                { icon: "shelf", label: @tr("Shelf") },
                { icon: "mascot", label: @tr("Mascot") },
                { icon: "system", label: @tr("System") },
            ]: NavItem {
                icon: item.icon;
                label: item.label;
                selected: root.page == i;
                clicked => { root.page = i; }
            }

            Rectangle { vertical-stretch: 1; }

            // Dernier enregistrement : discret quand tout va bien.
            if root.status != "": HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                padding-bottom: 6px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        name: root.status-error ? "alert" : "check";
                        ink: root.status-error ? Ui.error : Ui.ok;
                        width: 14px;
                        height: 14px;
                    }
                }

                Text {
                    text: root.status;
                    color: root.status-error ? Ui.error : Ui.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            NavItem {
                icon: "docs";
                label: @tr("Documentation");
                clicked => { root.open-docs(); }
            }

            NavItem {
                icon: "file";
                label: @tr("Open config.toml");
                clicked => { root.open-config-file(); }
            }
        }

        // --- Pages ---
        if root.page == 0: Page {
            title: @tr("General");

            Section {
                title: @tr("Island");

                Card {
                    Setting {
                        title: @tr("Language");
                        ComboBox {
                            width: 220px;
                            // Noms des langues dans leur propre langue : non traduits.
                            model: [@tr("Automatic (Windows)"), "English", "Français"];
                            current-index <=> root.language-index;
                            selected => { root.changed("general.language"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Welcome assistant");
                        description: @tr("Pick the modules again, connect Claude Code or a calendar.");
                        Button {
                            text: @tr("Open");
                            clicked => { root.open-welcome(); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Open the island");
                        ComboBox {
                            width: 220px;
                            model: [@tr("on hover"), @tr("on click")];
                            current-index <=> root.open-on-index;
                            selected => { root.changed("general.open_on"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Screen");
                        ComboBox {
                            width: 220px;
                            model: [@tr("main screen"), @tr("screen under the mouse (at startup)")];
                            current-index <=> root.monitor-index;
                            selected => { root.changed("general.monitor"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Hide in full screen");
                        description: @tr("Hide the island when an app is full screen");
                        Toggle {
                            checked <=> root.hide-fullscreen;
                            toggled => { root.changed("general.hide_in_fullscreen"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Gestures");
                        description: @tr("Wheel for volume, swipe to change track, long press for do not disturb");
                        Toggle {
                            checked <=> root.gestures-enabled;
                            toggled => { root.changed("modules.gestures.enabled"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Startup and updates");

                Card {
                    Setting {
                        title: @tr("Start BoringWindows with Windows");
                        Toggle {
                            checked <=> root.autostart;
                            toggled => { root.changed("autostart"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Install updates automatically");
                        Toggle {
                            checked <=> root.auto-update;
                            toggled => { root.changed("general.auto_update"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Version {}", root.app-version);
                        description: root.update-ready ? @tr("An update is ready.") : "";
                        Button {
                            text: root.update-ready ? @tr("Restart to update")
                                : root.update-checking ? @tr("Checking…") : @tr("Check for updates");
                            enabled: !root.update-checking;
                            primary: root.update-ready;
                            clicked => { root.update-clicked(); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Advanced");

                Card {
                    Setting {
                        title: @tr("WASM plugins");
                        description: @tr("Run WASM plugins (third-party code, sandboxed)");
                        Button {
                            text: @tr("Plugins folder");
                            clicked => { root.open-plugins-folder(); }
                        }
                        Toggle {
                            checked <=> root.plugins-enabled;
                            toggled => { root.changed("modules.plugins.enabled"); }
                        }
                    }
                }
            }
        }

        if root.page == 1: Page {
            title: @tr("Appearance");

            Section {
                title: @tr("Theme");

                Card {
                    Setting {
                        title: @tr("Theme");
                        description: @tr("Picking a theme replaces the colors below with the theme's. Your own themes go in the themes folder.");
                        Button {
                            text: @tr("Themes folder");
                            clicked => { root.open-themes-folder(); }
                        }
                        ComboBox {
                            width: 180px;
                            model: root.themes;
                            current-index <=> root.theme-index;
                            selected => { root.theme-picked(self.current-index); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Use the Windows accent color");
                        Toggle {
                            checked <=> root.system-accent;
                            toggled => { root.changed("theme.system_accent"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: !root.system-accent;
                        title: @tr("Accent color");
                        description: @tr("Replaced by the album art color while music plays.");
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 6px;
                            background: root.accent-preview;
                            border-width: 1px;
                            border-color: Ui.card-border;
                        }
                        LineEdit {
                            width: 120px;
                            enabled: !root.system-accent;
                            text <=> root.accent;
                            placeholder-text: "#FF8A3D";
                            edited => { root.changed("theme.accent"); }
                        }
                    }

                    if !root.system-accent: HorizontalLayout {
                        padding-left: 52px;
                        padding-right: 16px;
                        padding-bottom: 14px;
                        spacing: 6px;
                        alignment: start;

                        for c[i] in [#FF8A3D, #FF453A, #FFD60A, #30D158, #5AC8FA, #0A84FF, #BF5AF2, #FF375F]: Swatch {
                            swatch: c;
                            current: root.accent-preview == c;
                            picked => {
                                root.accent = ["#FF8A3D", "#FF453A", "#FFD60A", "#30D158", "#5AC8FA", "#0A84FF", "#BF5AF2", "#FF375F"][i];
                                root.changed("theme.accent");
                            }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Background color");
                        LineEdit {
                            width: 120px;
                            text <=> root.background-color;
                            placeholder-text: "#000000";
                            edited => { root.changed("theme.background"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Blur");
                        description: @tr("Blur what is behind the island (Windows 11, translucent themes)");
                        Toggle {
                            checked <=> root.blur;
                            toggled => { root.changed("theme.blur"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Claude glow");
                        description: @tr("Animated outline around the island while Claude works or waits for you");
                        Toggle {
                            checked <=> root.glow;
                            toggled => { root.changed("theme.glow"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Size and motion");

                Card {
                    Setting {
                        title: @tr("Compact island size (px)");
                        description: @tr("Width × height");
                        SpinBox {
                            width: 110px;
                            minimum: 16;
                            maximum: 4000;
                            value <=> root.compact-w;
                            edited => { root.changed("theme.compact"); }
                        }
                        Text {
                            text: "×";
                            color: Ui.muted;
                            vertical-alignment: center;
                        }
                        SpinBox {
                            width: 110px;
                            minimum: 8;
                            maximum: 2000;
                            value <=> root.compact-h;
                            edited => { root.changed("theme.compact"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Open island size (px)");
                        description: @tr("Width × height");
                        SpinBox {
                            width: 110px;
                            minimum: 16;
                            maximum: 4000;
                            value <=> root.expanded-w;
                            edited => { root.changed("theme.expanded"); }
                        }
                        Text {
                            text: "×";
                            color: Ui.muted;
                            vertical-alignment: center;
                        }
                        SpinBox {
                            width: 110px;
                            minimum: 8;
                            maximum: 2000;
                            value <=> root.expanded-h;
                            edited => { root.changed("theme.expanded"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Corner radius of the open island");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: 100;
                            value <=> root.corner-radius;
                            edited => { root.changed("theme.corner_radius"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Animation duration (ms)");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: 2000;
                            step-size: 20;
                            value <=> root.animation-ms;
                            edited => { root.changed("theme.animation_ms"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Priority in the compact island");

                Card {
                    for name[i] in root.module-order: Setting {
                        divided: i > 0;
                        min-height: 48px;
                        title: (i + 1) + ".  " + name;
                        description: i == 0 ? @tr("Wins when several modules want the island") : "";
                        Button {
                            text: "↑";
                            width: 40px;
                            enabled: i > 0;
                            clicked => { root.module-moved(i, -1); }
                        }
                        Button {
                            text: "↓";
                            width: 40px;
                            enabled: i < root.module-order.length - 1;
                            clicked => { root.module-moved(i, 1); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Advanced");

                Card {
                    Setting {
                        title: @tr("Custom view of the open island");
                        description: @tr("Name of a file in the layouts folder, without .slint. Leave empty for the built-in view; see the documentation for the data you can use.");
                        Button {
                            text: @tr("Layouts folder");
                            clicked => { root.open-layouts-folder(); }
                        }
                        LineEdit {
                            width: 150px;
                            text <=> root.view-name;
                            placeholder-text: "my-view";
                            edited => { root.changed("layout.view"); }
                        }
                    }
                }
            }
        }

        if root.page == 2: Page {
            title: @tr("Notifications");

            Section {
                title: @tr("Apps");

                Card {
                    Setting {
                        title: @tr("App notifications");
                        description: @tr("Show app notifications in the island (Discord, Slack, Teams…)");
                        Toggle {
                            checked <=> root.notifications-enabled;
                            toggled => { root.changed("modules.notifications.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.notifications-enabled;
                        title: @tr("Show the sender and the message of notifications");
                        Toggle {
                            enabled: root.notifications-enabled;
                            checked <=> root.notifications-content;
                            toggled => { root.changed("modules.notifications.show_content"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.notifications-enabled;
                        title: @tr("Open the right place on click");
                        description: @tr("The Discord channel, the browser tab… instead of just the app");
                        Toggle {
                            enabled: root.notifications-enabled;
                            checked <=> root.notifications-original;
                            toggled => { root.changed("modules.notifications.open_original"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("System");

                Card {
                    Setting {
                        title: @tr("Volume");
                        description: @tr("Show volume changes in the island");
                        Toggle {
                            checked <=> root.volume-enabled;
                            toggled => { root.changed("modules.volume.enabled"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Brightness");
                        description: @tr("Show brightness changes in the island (laptops)");
                        Toggle {
                            checked <=> root.brightness-enabled;
                            toggled => { root.changed("modules.brightness.enabled"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Battery");
                        description: @tr("Show the charger and battery level in the island (laptops)");
                        Toggle {
                            checked <=> root.battery-enabled;
                            toggled => { root.changed("modules.battery.enabled"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: "Bluetooth";
                        description: @tr("Show Bluetooth devices connecting, with their battery level");
                        Toggle {
                            checked <=> root.bluetooth-enabled;
                            toggled => { root.changed("modules.bluetooth.enabled"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Calls and screen sharing");

                Card {
                    Setting {
                        title: @tr("Presentation mode");
                        description: @tr("Stay quiet during calls and screen sharing");
                        Toggle {
                            checked <=> root.presentation-enabled;
                            toggled => { root.changed("modules.presentation.enabled"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Hide from capture");
                        description: @tr("Hide the island from screen sharing, recordings and screenshots");
                        Toggle {
                            checked <=> root.hide-from-capture;
                            toggled => { root.changed("modules.presentation.hide_from_capture"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.hide-from-capture;
                        title: @tr("Only during calls and screen sharing");
                        description: @tr("The rest of the time, your own screenshots show the island");
                        Toggle {
                            enabled: root.hide-from-capture;
                            checked <=> root.hide-only-when-live;
                            toggled => { root.changed("modules.presentation.hide_only_when_live"); }
                        }
                    }
                }
            }
        }

        if root.page == 3: Page {
            title: "Claude Code";

            Section {
                Card {
                    Setting {
                        title: @tr("Claude Code hooks");
                        description: @tr("After installing, restart your Claude Code sessions: they only read their hooks at startup.");
                        Badge {
                            text: root.hooks-installed ? @tr("Installed") : @tr("Not installed");
                            good: root.hooks-installed;
                        }
                        Button {
                            text: root.hooks-installed ? @tr("Remove hooks") : @tr("Install hooks");
                            primary: !root.hooks-installed;
                            clicked => { root.toggle-hooks(); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Permissions");

                Card {
                    Setting {
                        title: @tr("Answer permission requests from the island");
                        Toggle {
                            checked <=> root.claude-permissions;
                            toggled => { root.changed("modules.claude.permissions"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.claude-permissions;
                        title: @tr("Time to answer in the island (s)");
                        SpinBox {
                            width: 110px;
                            enabled: root.claude-permissions;
                            minimum: 5;
                            maximum: 280;
                            value <=> root.claude-wait;
                            edited => { root.changed("modules.claude.permission_wait_secs"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Sound when Claude is waiting for you");
                        description: @tr("A question, a plan or a permission");
                        Toggle {
                            checked <=> root.claude-sound;
                            toggled => { root.changed("modules.claude.sound"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Usage");

                Card {
                    Setting {
                        title: @tr("Recent conversations and usage (Claude Code)");
                        description: @tr("Usage is an estimate from Claude Code only; your plan's window also counts claude.ai and the app.");
                        Toggle {
                            checked <=> root.activity-enabled;
                            toggled => { root.changed("modules.claude_activity.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.activity-enabled;
                        title: @tr("Estimated limit, millions of tokens (0 = no gauge)");
                        SpinBox {
                            width: 130px;
                            enabled: root.activity-enabled;
                            minimum: 0;
                            maximum: 100000;
                            value <=> root.activity-limit-millions;
                            edited => { root.changed("modules.claude_activity.limit_millions"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.activity-enabled;
                        title: @tr("Window reset time (optional)");
                        description: @tr("Type the reset time that /usage shows (HH:MM) to align the countdown.");
                        LineEdit {
                            width: 90px;
                            enabled: root.activity-enabled;
                            text <=> root.activity-reset;
                            placeholder-text: "01:00";
                            edited => { root.changed("modules.claude_activity.reset_at"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Troubleshooting");

                Card {
                    Setting {
                        title: @tr("Diagnostic");
                        description: @tr("Checks the whole chain, from the hooks to the island.");
                        Button {
                            text: root.doctor-running ? @tr("Running diagnostic…") : @tr("Run diagnostic");
                            enabled: !root.doctor-running;
                            clicked => { root.run-doctor(); }
                        }
                    }

                    if root.doctor-report != "": VerticalLayout {
                        padding: 16px;
                        padding-top: 0px;

                        TextEdit {
                            text: root.doctor-report;
                            read-only: true;
                            font-size: 11px;
                            height: 260px;
                        }
                    }
                }
            }
        }

        if root.page == 4: Page {
            title: @tr("Calendar");

            Section {
                title: @tr("My calendars");

                if root.sources.length == 0: Card {
                    Setting {
                        title: @tr("No calendar yet: add one below.");
                    }
                }

                if root.sources.length > 0: Card {
                    for source[i] in root.sources: Setting {
                        divided: i > 0;
                        title: source.name != "" ? source.name : @tr("(no name)");
                        description: source.url;
                        Button {
                            text: @tr("Remove");
                            clicked => { root.remove-source(i); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Add a calendar");

                Card {
                    Setting {
                        title: @tr("Service");
                        description: root.provider-help;
                        Button {
                            text: @tr("Step-by-step guide");
                            clicked => { root.open-guide(); }
                        }
                        ComboBox {
                            width: 200px;
                            model: root.providers;
                            current-index <=> root.provider-index;
                            selected => { root.provider-changed(self.current-index); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Name (optional)");
                        LineEdit {
                            width: 300px;
                            text <=> root.new-name;
                            placeholder-text: @tr("Work, School, Personal…");
                        }
                    }

                    Setting {
                        divided: true;
                        title: root.provider-is-file ? @tr(".ics file") : root.provider-is-caldav ? @tr("Server address") : @tr("ICS link");
                        if root.provider-is-file: Button {
                            text: @tr("Browse…");
                            clicked => { root.browse-file(); }
                        }
                        LineEdit {
                            width: 300px;
                            text <=> root.new-url;
                            placeholder-text: root.provider-is-file ? "C:/Users/…/agenda.ics" : root.provider-is-caldav ? "https://caldav.icloud.com" : @tr("https://…  or  webcal://…");
                        }
                    }

                    if root.provider-is-caldav: Setting {
                        divided: true;
                        title: @tr("Login");
                        LineEdit {
                            width: 300px;
                            text <=> root.new-username;
                            placeholder-text: "name@icloud.com";
                        }
                    }

                    if root.provider-is-caldav: Setting {
                        divided: true;
                        title: @tr("App password");
                        LineEdit {
                            width: 300px;
                            text <=> root.new-password;
                            input-type: password;
                        }
                    }

                    Setting {
                        divided: true;
                        title: root.test-status;
                        title-color: root.test-ok ? Ui.ok : Ui.error;
                        Button {
                            text: root.testing ? @tr("Testing…") : @tr("Test");
                            enabled: !root.testing && root.source-ready;
                            clicked => { root.test-source(); }
                        }
                        Button {
                            text: @tr("Add");
                            primary: true;
                            enabled: root.source-ready;
                            clicked => { root.add-source(); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Display");

                Card {
                    Setting {
                        title: @tr("Reminder before start (min)");
                        SpinBox {
                            width: 110px;
                            minimum: 0;
                            maximum: 120;
                            value <=> root.remind-minutes;
                            edited => { root.changed("modules.calendar.remind_minutes"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Time span shown (hours)");
                        SpinBox {
                            width: 110px;
                            minimum: 1;
                            maximum: 168;
                            value <=> root.lookahead-hours;
                            edited => { root.changed("modules.calendar.lookahead_hours"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Refresh every (min)");
                        SpinBox {
                            width: 110px;
                            minimum: 2;
                            maximum: 1440;
                            value <=> root.refresh-minutes;
                            edited => { root.changed("modules.calendar.refresh_minutes"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Show all-day events");
                        Toggle {
                            checked <=> root.show-all-day;
                            toggled => { root.changed("modules.calendar.show_all_day"); }
                        }
                    }
                }
            }
        }

        if root.page == 5: Page {
            title: @tr("Music");

            Section {
                Card {
                    Setting {
                        title: @tr("Tint the island with the album art color");
                        Toggle {
                            checked <=> root.media-accent;
                            toggled => { root.changed("modules.media.accent_from_artwork"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Audio visualizer");
                        description: @tr("Uses some CPU while the island is open and music plays");
                        Toggle {
                            checked <=> root.viz-enabled;
                            toggled => { root.changed("modules.visualizer.enabled"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Players");

                if root.players.length > 0: Card {
                    for player[i] in root.players: Setting {
                        divided: i > 0;
                        min-height: 48px;
                        title: player.name;
                        // Allumé = affiché dans l'île ; éteint = ignoré.
                        Toggle {
                            checked: !player.ignored;
                            toggled => { root.player-toggled(player.token, !self.checked); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Players to ignore");
                        description: @tr("Separate names with commas; part of the name is enough. Spotify, Apple Music, browsers, VLC… are detected automatically.");
                        LineEdit {
                            width: 220px;
                            text <=> root.media-ignore;
                            placeholder-text: "msedge, chrome";
                            edited => { root.changed("modules.media.ignore"); }
                        }
                    }
                }

                if root.players.length > 0: Hint {
                    text: @tr("Players seen recently: turn one off to ignore it.");
                }
            }
        }

        if root.page == 6: Page {
            title: @tr("Weather");

            Section {
                Card {
                    Setting {
                        title: @tr("Show the weather");
                        description: @tr("Next to the date in the open island. Hover the temperature to see the forecast of the day.");
                        Toggle {
                            checked <=> root.weather-enabled;
                            toggled => { root.changed("modules.weather.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.weather-enabled;
                        title: @tr("City");
                        LineEdit {
                            width: 200px;
                            enabled: root.weather-enabled;
                            text <=> root.weather-city;
                            placeholder-text: "Lyon";
                            edited => { root.changed("modules.weather.city"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.weather-enabled;
                        title: @tr("Unit");
                        ComboBox {
                            width: 100px;
                            enabled: root.weather-enabled;
                            model: ["°C", "°F"];
                            current-index <=> root.weather-units-index;
                            selected => { root.changed("modules.weather.units"); }
                        }
                    }
                }

                Hint {
                    text: @tr("Data from open-meteo.com, free and without an account; only the city name and its coordinates are sent.");
                }
            }
        }

        if root.page == 7: Page {
            title: @tr("Timer");

            Section {
                Card {
                    Setting {
                        title: @tr("Show the timer in the open island");
                        Toggle {
                            checked <=> root.timer-enabled;
                            toggled => { root.changed("modules.timer.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.timer-enabled;
                        title: @tr("Play a sound when it ends");
                        Toggle {
                            enabled: root.timer-enabled;
                            checked <=> root.timer-sound;
                            toggled => { root.changed("modules.timer.sound"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.timer-enabled;
                        title: @tr("Durations (minutes)");
                        description: @tr("Up to 5 durations, separated by commas (1 to 600). 25 is the classic Pomodoro.");
                        LineEdit {
                            width: 160px;
                            enabled: root.timer-enabled;
                            text <=> root.timer-presets;
                            placeholder-text: "5, 15, 25";
                            edited => { root.changed("modules.timer.presets"); }
                        }
                    }
                }

                Hint {
                    text: @tr("Open the island and pick a duration to start.");
                }
            }
        }

        if root.page == 8: Page {
            title: @tr("Shelf");

            Section {
                Card {
                    Setting {
                        title: @tr("Keep files dropped on the island");
                        description: @tr("Drag files onto the island to keep them at hand; click one to open it, × to remove it. Only the path is kept, never a copy.");
                        Toggle {
                            checked <=> root.shelf-enabled;
                            toggled => { root.changed("modules.shelf.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.shelf-enabled;
                        title: @tr("Files kept (max)");
                        SpinBox {
                            width: 110px;
                            enabled: root.shelf-enabled;
                            minimum: 1;
                            maximum: 30;
                            value <=> root.shelf-max;
                            edited => { root.changed("modules.shelf.max"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.shelf-enabled;
                        title: @tr("Empty the shelf");
                        Button {
                            text: @tr("Empty");
                            enabled: root.shelf-enabled;
                            clicked => { root.shelf-clear(); }
                        }
                    }
                }
            }
        }

        if root.page == 9: Page {
            title: @tr("Mascot");

            Section {
                Card {
                    Setting {
                        title: @tr("Show the mascot in the island");
                        description: @tr("It reacts to Claude Code, dances to the music, falls asleep when you are away and gets sleepy in the evening.");
                        Toggle {
                            checked <=> root.mascot-enabled;
                            toggled => { root.changed("modules.mascot.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.mascot-enabled;
                        title: @tr("Always animated");
                        description: @tr("Breathes and blinks, uses a little CPU. Otherwise it only moves when something happens.");
                        Toggle {
                            enabled: root.mascot-enabled;
                            checked <=> root.mascot-always-animated;
                            toggled => { root.changed("modules.mascot.always_animated"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.mascot-enabled;
                        title: @tr("Dance to the music");
                        Toggle {
                            enabled: root.mascot-enabled;
                            checked <=> root.mascot-music;
                            toggled => { root.changed("modules.mascot.music"); }
                        }
                    }
                }

                Card {
                    Setting {
                        title: @tr("Seasonal decorations");
                        description: @tr("Halloween, Christmas, New Year");
                        Toggle {
                            checked <=> root.mascot-seasonal;
                            toggled => { root.changed("modules.mascot.seasonal"); }
                        }
                    }
                }

                Card {
                    Setting {
                        enabled: root.mascot-enabled;
                        title: @tr("Accessory");
                        description: @tr("Worn by the big mascot of the open island.");
                        ComboBox {
                            width: 180px;
                            enabled: root.mascot-enabled;
                            model: [@tr("Sprout"), @tr("Glasses"), @tr("Headphones"), @tr("Bow"), @tr("None")];
                            current-index <=> root.mascot-accessory-index;
                            selected => { root.changed("modules.mascot.accessory"); }
                        }
                    }

                    Setting {
                        enabled: root.mascot-enabled;
                        title: @tr("Color");
                        description: @tr("The first one follows the theme.");
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 14px;
                        spacing: 6px;
                        alignment: start;

                        Swatch {
                            swatch: Ui.text;
                            current: root.mascot-color == "";
                            picked => {
                                root.mascot-color = "";
                                root.changed("modules.mascot.color");
                            }
                        }

                        for c[i] in [#FFF1DC, #FFB3C7, #FF9E7A, #FFD66B, #9FE8C2, #8FD3FF, #C3B1FF, #B0B0B8]: Swatch {
                            swatch: c;
                            current: root.mascot-color == ["#FFF1DC", "#FFB3C7", "#FF9E7A", "#FFD66B", "#9FE8C2", "#8FD3FF", "#C3B1FF", "#B0B0B8"][i];
                            picked => {
                                root.mascot-color = ["#FFF1DC", "#FFB3C7", "#FF9E7A", "#FFD66B", "#9FE8C2", "#8FD3FF", "#C3B1FF", "#B0B0B8"][i];
                                root.changed("modules.mascot.color");
                            }
                        }
                    }
                }
            }
        }

        if root.page == 10: Page {
            title: @tr("System");

            Section {
                title: @tr("CPU and memory");

                Card {
                    Setting {
                        title: @tr("Show the CPU and memory use");
                        description: @tr("Next to the time in the open island. Measured only while the island is open.");
                        Toggle {
                            checked <=> root.system-enabled;
                            toggled => { root.changed("modules.system.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.system-enabled;
                        title: @tr("Refresh (seconds)");
                        SpinBox {
                            width: 110px;
                            enabled: root.system-enabled;
                            minimum: 1;
                            maximum: 10;
                            value <=> root.system-refresh;
                            edited => { root.changed("modules.system.refresh_secs"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.system-enabled;
                        title: @tr("Alert when the CPU stays above");
                        ComboBox {
                            width: 120px;
                            enabled: root.system-enabled;
                            model: [@tr("never"), "70 %", "80 %", "90 %", "95 %"];
                            current-index <=> root.cpu-alert-index;
                            selected => { root.changed("modules.system.cpu_alert_percent"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.system-enabled;
                        title: @tr("Alert when the memory stays above");
                        ComboBox {
                            width: 120px;
                            enabled: root.system-enabled;
                            model: [@tr("never"), "70 %", "80 %", "90 %", "95 %"];
                            current-index <=> root.ram-alert-index;
                            selected => { root.changed("modules.system.ram_alert_percent"); }
                        }
                    }
                }

                Hint {
                    text: @tr("With an alert, a measure is also taken every 5 seconds, and the pill names the app responsible after 30 seconds above the threshold.");
                }
            }

            Section {
                title: @tr("Network");

                Card {
                    Setting {
                        title: @tr("Show the network");
                        description: @tr("An icon next to the time in the open island: Wi-Fi, wired, VPN or offline. Hover it for the network and the speeds.");
                        Toggle {
                            checked <=> root.network-enabled;
                            toggled => { root.changed("modules.network.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.network-enabled;
                        title: @tr("Speed in the collapsed island");
                        description: @tr("Music and Claude take precedence over the speed.");
                        ComboBox {
                            width: 150px;
                            enabled: root.network-enabled;
                            model: [@tr("never"), @tr("when data moves"), @tr("always")];
                            current-index <=> root.network-compact-index;
                            selected => { root.changed("modules.network.compact_speed"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.network-enabled;
                        title: @tr("Speed unit");
                        ComboBox {
                            width: 150px;
                            enabled: root.network-enabled;
                            model: [@tr("Bytes (MB/s)"), @tr("Bits (Mb/s)")];
                            current-index <=> root.network-unit-index;
                            selected => { root.changed("modules.network.unit"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.network-enabled;
                        title: @tr("Announce lost and restored connection");
                        Toggle {
                            enabled: root.network-enabled;
                            checked <=> root.network-announce-connection;
                            toggled => { root.changed("modules.network.announce_connection"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.network-enabled;
                        title: @tr("Announce VPN connected or disconnected");
                        Toggle {
                            enabled: root.network-enabled;
                            checked <=> root.network-announce-vpn;
                            toggled => { root.changed("modules.network.announce_vpn"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.network-enabled;
                        title: @tr("Announce a new Wi-Fi network");
                        Toggle {
                            enabled: root.network-enabled;
                            checked <=> root.network-announce-wifi;
                            toggled => { root.changed("modules.network.announce_wifi"); }
                        }
                    }
                }

                Hint {
                    text: @tr("The VPN is detected from a network adapter that is up and has a VPN name or the tunnel type (OpenVPN, WireGuard, FortiClient, Windows VPN…): a client that names its adapter differently may not be recognized.");
                }
            }

            Section {
                title: @tr("Transfers");

                Card {
                    Setting {
                        title: @tr("Show file transfers");
                        description: @tr("A progress bar at the bottom of the collapsed island while files are copied or downloaded.");
                        Toggle {
                            checked <=> root.transfers-enabled;
                            toggled => { root.changed("modules.transfers.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.transfers-enabled;
                        title: @tr("Copies and moves in File Explorer");
                        Toggle {
                            enabled: root.transfers-enabled;
                            checked <=> root.transfers-copies;
                            toggled => { root.changed("modules.transfers.copies"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.transfers-enabled;
                        title: @tr("Browser downloads");
                        Toggle {
                            enabled: root.transfers-enabled;
                            checked <=> root.transfers-downloads;
                            toggled => { root.changed("modules.transfers.downloads"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.transfers-enabled;
                        title: @tr("Announce when a transfer finishes");
                        Toggle {
                            enabled: root.transfers-enabled;
                            checked <=> root.transfers-announce;
                            toggled => { root.changed("modules.transfers.announce_done"); }
                        }
                    }
                }

                Hint {
                    text: @tr("Browsers do not tell the final size of a download: its bar moves back and forth, and the island shows the size received and the speed.");
                }
            }

            Section {
                title: "GitHub";

                Card {
                    Setting {
                        title: @tr("Show GitHub status");
                        description: @tr("An icon next to the time: the CI of your open pull requests, and a dot when a review is requested. Click it to open the page that needs you.");
                        Toggle {
                            checked <=> root.github-enabled;
                            toggled => { root.changed("modules.github.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.github-enabled;
                        title: @tr("Use the GitHub CLI session");
                        description: @tr("Without a saved token, ask `gh auth token`. Nothing to type if you are already logged in with gh.");
                        Toggle {
                            enabled: root.github-enabled;
                            checked <=> root.github-use-gh;
                            toggled => { root.changed("modules.github.use_gh_cli"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.github-enabled;
                        title: @tr("Access token");
                        description: root.github-token-saved ? @tr("A token is saved in the Windows Credential Manager.") : @tr("Paste a token (scopes: repo, read:org) and press Enter. It goes to the Windows Credential Manager.");
                        LineEdit {
                            width: 200px;
                            enabled: root.github-enabled;
                            text <=> root.github-token;
                            input-type: password;
                            placeholder-text: "ghp_…";
                            accepted => { root.changed("modules.github.token"); }
                        }
                        if root.github-token-saved: Button {
                            text: @tr("Forget");
                            clicked => { root.changed("modules.github.token_clear"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.github-enabled;
                        title: @tr("Refresh");
                        ComboBox {
                            width: 150px;
                            enabled: root.github-enabled;
                            model: [@tr("every minute"), @tr("every 2 minutes"), @tr("every 5 minutes"), @tr("every 10 minutes"), @tr("every 30 minutes")];
                            current-index <=> root.github-refresh-index;
                            selected => { root.changed("modules.github.refresh_secs"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.github-enabled;
                        title: @tr("Announce CI results");
                        Toggle {
                            enabled: root.github-enabled;
                            checked <=> root.github-announce-ci;
                            toggled => { root.changed("modules.github.announce_ci"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.github-enabled;
                        title: @tr("Announce review requests");
                        Toggle {
                            enabled: root.github-enabled;
                            checked <=> root.github-announce-reviews;
                            toggled => { root.changed("modules.github.announce_reviews"); }
                        }
                    }
                }

                Hint {
                    text: @tr("GitHub has no event to listen to: the island asks once per interval, in a single request.");
                }
            }

            Section {
                title: @tr("Tasks");

                Card {
                    Setting {
                        title: @tr("Show quick tasks");
                        description: @tr("A Tasks tab in the open island: check tasks off with a click. They live in a Markdown file you can also edit by hand.");
                        Toggle {
                            checked <=> root.tasks-enabled;
                            toggled => { root.changed("modules.tasks.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.tasks-enabled;
                        title: @tr("Add a task");
                        description: @tr("Shortcut that opens a small box under the island.");
                        LineEdit {
                            width: 200px;
                            enabled: root.tasks-enabled;
                            text <=> root.hotkey-quick-add;
                            placeholder-text: "Ctrl+Alt+N";
                            edited => { root.changed("hotkeys.quick_add"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.tasks-enabled;
                        title: @tr("Tasks file");
                        description: @tr("tasks.md next to config.toml: one \"- [ ] task\" line per task.");
                        Button {
                            text: @tr("Open");
                            enabled: root.tasks-enabled;
                            clicked => { root.changed("tasks.open_file"); }
                        }
                    }
                }
            }

            Section {
                title: @tr("Ask Claude or Gemini");

                Card {
                    Setting {
                        title: @tr("Ask from the island");
                        description: @tr("A shortcut opens a box under the island: type a question, and the answer shows in the island.");
                        Toggle {
                            checked <=> root.ask-enabled;
                            toggled => { root.changed("modules.ask.enabled"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.ask-enabled;
                        title: @tr("Model");
                        description: @tr("Picks the provider too. Other models: edit modules.ask.model in config.toml.");
                        ComboBox {
                            width: 210px;
                            enabled: root.ask-enabled;
                            model: root.ask-models;
                            current-index <=> root.ask-model-index;
                            selected => { root.changed("modules.ask.model"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.ask-enabled;
                        title: @tr("Claude API key");
                        description: root.ask-claude-saved ? @tr("A key is saved in the Windows Credential Manager.") : @tr("From console.anthropic.com. Paste it and press Enter: it goes to the Windows Credential Manager.");
                        LineEdit {
                            width: 200px;
                            enabled: root.ask-enabled;
                            text <=> root.ask-claude-key;
                            input-type: password;
                            placeholder-text: "sk-ant-…";
                            accepted => { root.changed("modules.ask.claude_key"); }
                        }
                        if root.ask-claude-saved: Button {
                            text: @tr("Forget");
                            clicked => { root.changed("modules.ask.claude_key_clear"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.ask-enabled;
                        title: @tr("Gemini API key");
                        description: root.ask-gemini-saved ? @tr("A key is saved in the Windows Credential Manager.") : @tr("From aistudio.google.com. Paste it and press Enter: it goes to the Windows Credential Manager.");
                        LineEdit {
                            width: 200px;
                            enabled: root.ask-enabled;
                            text <=> root.ask-gemini-key;
                            input-type: password;
                            placeholder-text: "AIza…";
                            accepted => { root.changed("modules.ask.gemini_key"); }
                        }
                        if root.ask-gemini-saved: Button {
                            text: @tr("Forget");
                            clicked => { root.changed("modules.ask.gemini_key_clear"); }
                        }
                    }

                    Setting {
                        nested: true;
                        enabled: root.ask-enabled;
                        title: @tr("Shortcut");
                        LineEdit {
                            width: 200px;
                            enabled: root.ask-enabled;
                            text <=> root.hotkey-ask;
                            placeholder-text: "Ctrl+Alt+Space";
                            edited => { root.changed("hotkeys.ask"); }
                        }
                    }
                }

                Hint {
                    text: @tr("Each question is sent alone to the provider you picked, with your key. Nothing else leaves your PC.");
                }
            }

            Section {
                title: @tr("Keyboard shortcuts");

                Card {
                    Setting {
                        title: @tr("Open or close the island");
                        LineEdit {
                            width: 200px;
                            text <=> root.hotkey-toggle;
                            placeholder-text: "Ctrl+Alt+B";
                            edited => { root.changed("hotkeys.toggle"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Play / pause");
                        LineEdit {
                            width: 200px;
                            text <=> root.hotkey-play-pause;
                            placeholder-text: "Ctrl+Alt+P";
                            edited => { root.changed("hotkeys.play_pause"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Next track");
                        LineEdit {
                            width: 200px;
                            text <=> root.hotkey-next;
                            placeholder-text: "Ctrl+Alt+Right";
                            edited => { root.changed("hotkeys.next_track"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Previous track");
                        LineEdit {
                            width: 200px;
                            text <=> root.hotkey-previous;
                            placeholder-text: "Ctrl+Alt+Left";
                            edited => { root.changed("hotkeys.previous_track"); }
                        }
                    }

                    Setting {
                        divided: true;
                        title: @tr("Do not disturb");
                        LineEdit {
                            width: 200px;
                            text <=> root.hotkey-dnd;
                            placeholder-text: "Ctrl+Alt+D";
                            edited => { root.changed("hotkeys.do_not_disturb"); }
                        }
                    }
                }

                Hint {
                    text: @tr("They work in every app. Combine Ctrl, Alt, Shift or Super (Windows key, Cmd on a Mac) with a key: A to Z, 0 to 9, F1 to F24, Space, Up, Down, Left, Right… Leave empty for no shortcut.");
                }
            }
        }
    }
}

// Un module proposé par l'assistant d'accueil : nom, ce qu'il montre,
// interrupteur.
component ModuleChoice inherits Setting {
    in-out property <bool> on;
    divided: true;

    Toggle {
        checked <=> root.on;
    }
}

// Assistant d'accueil : ouvert au premier lancement (ou depuis Réglages ›
// Général). Quatre étapes ; les choix de modules ne sont écrits qu'à la fin,
// en une fois (chaque écriture redémarre les modules).
export component WelcomeWindow inherits Window {
    title: @tr("Welcome to BoringWindows");
    preferred-width: 640px;
    preferred-height: 640px;
    min-width: 560px;
    min-height: 540px;
    background: Ui.window;

    // 0 bienvenue, 1 modules, 2 outils, 3 prêt.
    in-out property <int> step;
    in-out property <int> language-index;

    in-out property <bool> claude;
    in-out property <bool> media;
    in-out property <bool> calendar;
    in-out property <bool> notifications;
    in-out property <bool> weather;
    in-out property <string> weather-city;
    in-out property <bool> timer;
    in-out property <bool> tasks;
    in-out property <bool> mascot;
    in-out property <bool> network;
    in-out property <bool> system;

    // Claude Code trouvé sur ce PC (`~/.claude`), hooks déjà là.
    in property <bool> claude-detected;
    in property <bool> hooks-installed;
    // Raccourci qui ouvre l'île (vide : aucun).
    in property <string> toggle-hotkey;

    callback language-changed();
    callback install-hooks();
    callback add-calendar();
    callback open-settings();
    callback finish();

    VerticalLayout {
        padding: 32px;
        spacing: 20px;

        // Avancement : un trait par étape.
        HorizontalLayout {
            spacing: 6px;
            for i in 4: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: i <= root.step ? Ui.accent : Ui.divider;
                animate background { duration: 200ms; }
            }
        }

        // --- 0 : bienvenue ---
        if root.step == 0: VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            Text {
                text: @tr("Welcome to BoringWindows");
                color: Ui.text;
                font-size: 28px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: @tr("A small island at the top of your screen: it stays out of the way, and grows when something deserves your attention (Claude Code waiting for you, a new song, a meeting in 5 minutes). Hover it to open it.");
                color: Ui.muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            Text {
                text: @tr("This takes a minute. Everything can be changed later in Settings.");
                color: Ui.muted;
                font-size: 14px;
                wrap: word-wrap;
            }

            Card {
                Setting {
                    title: @tr("Language");
                    ComboBox {
                        width: 220px;
                        // Noms des langues dans leur propre langue : non traduits.
                        model: [@tr("Automatic (Windows)"), "English", "Français"];
                        current-index <=> root.language-index;
                        selected => { root.language-changed(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // --- 1 : modules ---
        if root.step == 1: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: @tr("What should the island show?");
                color: Ui.text;
                font-size: 24px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: @tr("A module that is off costs nothing: it doesn't even start.");
                color: Ui.muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            sv := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    width: sv.visible-width;
                    padding-right: 12px;

                    Card {
                        ModuleChoice {
                            divided: false;
                            title: "Claude Code";
                            description: @tr("What Claude is doing, its questions and permission requests");
                            on <=> root.claude;
                        }
                        ModuleChoice {
                            title: @tr("Music");
                            description: @tr("Song, cover and controls (Spotify, browsers, Apple Music…)");
                            on <=> root.media;
                        }
                        ModuleChoice {
                            title: @tr("Calendar");
                            description: @tr("Next meeting, countdown and a Join button");
                            on <=> root.calendar;
                        }
                        ModuleChoice {
                            title: @tr("Notifications");
                            description: @tr("Messages from your apps (Discord, Slack, Teams…)");
                            on <=> root.notifications;
                        }
                        ModuleChoice {
                            title: @tr("Weather");
                            description: @tr("Current weather next to the date");
                            on <=> root.weather;
                        }
                        if root.weather: Setting {
                            nested: true;
                            title: @tr("City");
                            LineEdit {
                                width: 200px;
                                text <=> root.weather-city;
                                placeholder-text: "Paris";
                            }
                        }
                        ModuleChoice {
                            title: @tr("Timer");
                            description: @tr("Pomodoro, focus sessions, cooking");
                            on <=> root.timer;
                        }
                        ModuleChoice {
                            title: @tr("Quick tasks");
                            description: @tr("A checklist in the island, added with a shortcut");
                            on <=> root.tasks;
                        }
                        ModuleChoice {
                            title: @tr("Mascot");
                            description: @tr("A little blob that reacts to Claude, music and the time of day");
                            on <=> root.mascot;
                        }
                        ModuleChoice {
                            title: @tr("Network");
                            description: @tr("Wi-Fi, VPN and speed");
                            on <=> root.network;
                        }
                        ModuleChoice {
                            title: @tr("CPU and memory");
                            description: @tr("Next to the time, measured only while the island is open");
                            on <=> root.system;
                        }
                    }
                }
            }
        }

        // --- 2 : outils ---
        if root.step == 2: VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Text {
                text: @tr("Connect your tools");
                color: Ui.text;
                font-size: 24px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: @tr("Both are optional; you can do it later from Settings.");
                color: Ui.muted;
                font-size: 13px;
                wrap: word-wrap;
            }

            Card {
                Setting {
                    title: "Claude Code";
                    description: !root.claude ? @tr("The Claude Code module is off.")
                        : !root.claude-detected ? @tr("Claude Code was not found on this PC. Install it, then come back to Settings › Claude Code.")
                        : root.hooks-installed ? @tr("Connected. Restart your Claude Code sessions so they pick it up.")
                        : @tr("BoringWindows adds a few hooks to ~/.claude/settings.json (with a backup) to follow your sessions.");
                    enabled: root.claude && root.claude-detected;
                    if root.hooks-installed: Badge {
                        text: @tr("Installed");
                        good: true;
                    }
                    if !root.hooks-installed: Button {
                        text: @tr("Install the hooks…");
                        enabled: root.claude && root.claude-detected;
                        clicked => { root.install-hooks(); }
                    }
                }
            }

            Card {
                Setting {
                    title: @tr("Calendar");
                    description: root.calendar
                        ? @tr("Google, Outlook, iCloud, Proton… The settings walk you through finding the link.")
                        : @tr("The Calendar module is off.");
                    enabled: root.calendar;
                    Button {
                        text: @tr("Add a calendar…");
                        enabled: root.calendar;
                        clicked => { root.add-calendar(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // --- 3 : prêt ---
        if root.step == 3: VerticalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            Text {
                text: @tr("You're all set");
                color: Ui.text;
                font-size: 24px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Card {
                Setting {
                    title: @tr("Open the island");
                    description: root.toggle-hotkey == ""
                        ? @tr("Hover the pill at the top of the screen, or click it.")
                        : @tr("Hover the pill at the top of the screen, or press {}.", root.toggle-hotkey);
                }
                Setting {
                    divided: true;
                    title: @tr("Settings");
                    description: @tr("Right-click the BoringWindows icon in the notification area.");
                }
                Setting {
                    divided: true;
                    title: @tr("Make it yours");
                    description: @tr("Themes, sizes, shortcuts, order of the modules: everything is in Settings, or in config.toml.");
                    Button {
                        text: @tr("Open Settings");
                        clicked => { root.open-settings(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // Navigation.
        HorizontalLayout {
            spacing: 8px;

            if root.step < 3: Button {
                text: @tr("Skip");
                clicked => { root.finish(); }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.step > 0: Button {
                text: @tr("Back");
                clicked => { root.step -= 1; }
            }

            if root.step < 3: Button {
                text: @tr("Next");
                primary: true;
                clicked => { root.step += 1; }
            }

            if root.step == 3: Button {
                text: @tr("Finish");
                primary: true;
                clicked => { root.finish(); }
            }
        }
    }
}
