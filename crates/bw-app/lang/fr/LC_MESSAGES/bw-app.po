msgstr "Test…"

msgid "Time span shown (hours)"
msgstr "Horizon affiché (heures)"

msgid "Time to answer in the island (s)"
msgstr "Délai de réponse dans l'île (s)"

msgid "Tint the island with the album art color"
msgstr "Teinter l'île avec la couleur de la pochette"

msgid "Work, School, Personal…"
msgstr "Pro, Cours, Perso…"

msgid "https://…  or  webcal://…"
msgstr "https://…  ou  webcal://…"

