msgstr "Redémarrer pour mettre à jour"

msgid "Checking…"
msgstr "Recherche…"

msgid "Check for updates"
msgstr "Rechercher une mise à jour"

msgid "Players seen recently (tick to ignore)"
msgstr "Lecteurs vus récemment (cocher pour ignorer)"

msgid "Compact island size (px)"
msgstr "Taille de l'île compacte (px)"

msgid "Open island size (px)"
msgstr "Taille de l'île ouverte (px)"

msgid "Priority in the compact island (first wins)"
msgstr "Priorité dans l'île compacte (le premier gagne)"

msgid "Server address"
msgstr "Adresse du serveur"

msgid "Login"
msgstr "Identifiant"

msgid "App password"
msgstr "Mot de passe d'application"

msgid "Timer"
msgstr "Minuteur"

msgid "Time's up!"
msgstr "C'est fini !"

