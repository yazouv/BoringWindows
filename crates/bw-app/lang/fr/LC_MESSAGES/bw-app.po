msgstr "Fichier .ics"

msgid "Accent color"
msgstr "Couleur d'accent"

msgid "Add"
msgstr "Ajouter"

msgid "Add a calendar"
msgstr "Ajouter un calendrier"

msgid "After installing, restart your Claude Code sessions: they only read their hooks at startup."
msgstr "Après une installation, relance tes sessions Claude Code : elles ne lisent leurs hooks qu'au démarrage."

msgid "All quiet"
msgstr "Rien à signaler"

msgid "Allow"
msgstr "Autoriser"

