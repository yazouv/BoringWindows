msgstr "Aucun calendrier pour l'instant : ajoute-en un ci-dessous."

msgid "Open config.toml"
msgstr "Ouvrir config.toml"

msgid "Open the island"
msgstr "Ouvrir l'île"

msgid "Players to ignore"
msgstr "Lecteurs à ignorer"

